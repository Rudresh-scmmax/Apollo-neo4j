@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://api.stardog.com/> .

:BenchmarkPriceShape
    a sh:NodeShape ;
    sh:targetClass :BenchmarkPrice ;
    sh:property [
        sh:path :price_date ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "price date" ;
        sh:description "The date of the price event." ;
    ] ;
    sh:property [
        sh:path :observedFor ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:name "material reference" ;
        sh:description "A reference to the material entity." ;
    ] .
