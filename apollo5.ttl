#################################################################
#  Classes Incoterms, CostComponent, CostEstimate - Begin
#################################################################

:Incoterm rdf:type owl:Class ;
    rdfs:subClassOf gist:Category ;
    rdfs:label "Incoterm (Incoterms® 2020)"@en ;
    rdfs:comment "International Commercial Terms (Incoterms® 2020) published by the ICC, defining responsibilities of buyer and seller for delivery, risk, and cost allocation in international trade."@en .



####******************************************************************************
# Incoterms® 2020 — instances / values with explicit responsibilities - Begin
###******************************************************************************

:EXW rdf:type :Incoterm ;
    rdfs:label "EXW (Ex Works) — Incoterms® 2020"@en ;
    rdfs:comment "Seller makes goods available at own premises. Buyer bears all costs and risks from that point onward."@en ;
    :buyerBearsCost :ExportPackaging, :ExportClearance, :InlandTransport, :OceanFreight, :AirFreight, :Insurance, :ImportClearance, :ImportDuty, :Unloading .

:FOB rdf:type :Incoterm ;
    rdfs:label "FOB (Free On Board) — Incoterms® 2020"@en ;
    rdfs:comment "Seller delivers goods on board the vessel at the port of shipment. Buyer bears costs and risks from that point onward."@en ;
    :sellerBearsCost :ExportPackaging, :ExportClearance, :InlandTransport ;
    :buyerBearsCost  :OceanFreight, :Insurance, :ImportClearance, :ImportDuty, :Unloading .
	
:CIF rdf:type :Incoterm ;
    rdfs:label "CIF (Cost, Insurance and Freight) — Incoterms® 2020"@en ;
    rdfs:comment "Seller pays cost, insurance, and freight to the port of destination. Buyer bears risks from shipment and import-side costs."@en ;
    :sellerBearsCost :ExportPackaging, :ExportClearance, :InlandTransport, :OceanFreight, :Insurance ;
    :buyerBearsCost  :ImportClearance, :ImportDuty, :Unloading .

:DAP rdf:type :Incoterm ;
    rdfs:label "DAP (Delivered At Place) — Incoterms® 2020"@en ;
    rdfs:comment "Seller delivers goods ready for unloading at the named destination. Buyer handles import clearance and duties."@en ;
    :sellerBearsCost :ExportPackaging, :ExportClearance, :InlandTransport, :OceanFreight, :AirFreight, :Insurance ;
    :buyerBearsCost  :ImportClearance, :ImportDuty, :Unloading .

:DDP rdf:type :Incoterm ;
    rdfs:label "DDP (Delivered Duty Paid) — Incoterms® 2020"@en ;
    rdfs:comment "Seller bears all costs and risks, including import duties and taxes, delivering goods to the named place."@en ;
    :sellerBearsCost :ExportPackaging, :ExportClearance, :InlandTransport, :OceanFreight, :AirFreight, :Insurance, :ImportClearance, :ImportDuty ;
    :buyerBearsCost  :Unloading .

###******************************************************************************
# Incoterms® 2020 — instances / values with explicit responsibilities - End
###******************************************************************************

:ResponsibilityBoundary rdf:type owl:Class ;
    rdfs:subClassOf gist:Category ;
    rdfs:label "Responsibility Boundary"@en .

###******************************************************************************
# ResponsibilityBoundary — instances / values - Begin
###******************************************************************************

:ExportPort rdf:type :ResponsibilityBoundary ;
    rdfs:label "Export Port"@en .

:ImportPort rdf:type :ResponsibilityBoundary ;
    rdfs:label "Import Port"@en .

:NamedPlace rdf:type :ResponsibilityBoundary ;
    rdfs:label "Named Place"@en .

###******************************************************************************
# ResponsibilityBoundary — instances / values - End
###******************************************************************************


:CostComponent rdf:type owl:Class ;
    rdfs:subClassOf gist:Category ;
    rdfs:label "Cost Component"@en ;
    rdfs:comment "A distinct cost element incurred in supplying goods from seller to buyer, such as freight, insurance, duties, or inland transport. Used to explicitly allocate cost responsibility under Incoterms."@en .

###******************************************************************************
# CostComponent Instances / values - Begin
###******************************************************************************

:ExportPackaging rdf:type :CostComponent ;
    rdfs:label "Export Packaging"@en ;
    rdfs:comment "Cost of packaging goods suitable for export, including materials and labor."@en .

:ExportClearance rdf:type :CostComponent ;
    rdfs:label "Export Clearance"@en ;
    rdfs:comment "Cost of export customs formalities, documentation, and associated fees in the country of export."@en .

:InlandTransport rdf:type :CostComponent ;
    rdfs:label "Inland Transport"@en ;
    rdfs:comment "Cost of transporting goods within a country by road, rail, or inland waterways."@en .

:OceanFreight rdf:type :CostComponent ;
    rdfs:label "Ocean Freight"@en ;
    rdfs:comment "Cost of transporting goods by sea between ports, excluding insurance and inland transport."@en .

:AirFreight rdf:type :CostComponent ;
    rdfs:label "Air Freight"@en ;
    rdfs:comment "Cost of transporting goods by air between airports."@en .

:Insurance rdf:type :CostComponent ;
    rdfs:label "Cargo Insurance"@en ;
    rdfs:comment "Cost of insuring goods against loss or damage during transit."@en .

:ImportClearance rdf:type :CostComponent ;
    rdfs:label "Import Clearance"@en ;
    rdfs:comment "Cost of import customs formalities, documentation, and associated fees in the country of import."@en .

:ImportDuty rdf:type :CostComponent ;
    rdfs:label "Import Duty & Taxes"@en ;
    rdfs:comment "Customs duties, taxes, and levies payable upon import."@en .

:Unloading rdf:type :CostComponent ;
    rdfs:label "Unloading"@en ;
    rdfs:comment "Cost of unloading goods at the destination point."@en .


###******************************************************************************
# CostComponent Instances / Values - End
###******************************************************************************

#################################################################
# Cost Rule Template (refactored)
#################################################################

:CostRuleTemplate rdf:type owl:Class ;
    rdfs:subClassOf gist:Information ;
    rdfs:label "Cost Rule Template"@en ;
    rdfs:comment "A reusable rule definition describing how a cost component is calculated and which parameters influence it. CostRuleTemplate represents logic, not instantiated market values."@en .

#################################################################
# Cost Rule Templates — instances / values - Begin
#################################################################

:OceanFreightRuleTemplate rdf:type :CostRuleTemplate ;
    rdfs:label "Ocean Freight Cost Rule Template"@en ;
    :forCostComponent :OceanFreight ;
    :requiresParameter :LogisticsRoute ;
    :requiresParameter :ShipmentMode ;
    :requiresParameter :Distance .

:InsuranceRuleTemplate rdf:type :CostRuleTemplate ;
    rdfs:label "Insurance Cost Rule Template"@en ;
    :forCostComponent :Insurance ;
    :requiresParameter :InvoiceValue ;
    :requiresParameter :ShipmentMode .

:ImportDutyRuleTemplate rdf:type :CostRuleTemplate ;
    rdfs:label "Import Duty Rule Template"@en ;
    :forCostComponent :ImportDuty ;
    :requiresParameter :HSNCode ;
    :requiresParameter :CountryOfOrigin ;
    :requiresParameter :TradeAgreement .

#################################################################
# Cost Rule Templates — instances / values - End
#################################################################



:CostRuleTemplateParameters rdf:type owl:Class ;
    rdfs:subClassOf gist:Category ;
    rdfs:label "Cost Rule Template Parameters"@en ;
    rdfs:comment "A controlled vocabulary of parameters that are used in CostRuleTemplate."@en .



