#################################################################

###  http://www.apollo-procurement.org/ontology#Quotation
:Quotation rdf:type owl:Class ;
           rdfs:subClassOf gist:Offer ;
           rdfs:label "Quotation"@en .


###  http://www.apollo-procurement.org/ontology#QuotededPrice
:QuotedPrice rdf:type owl:Class ;
                 rdfs:subClassOf :PriceObservation ;
                 rdfs:comment "A price provided by a supplier during a commercial interaction like a quotation or a negotiation."@en ;
                 rdfs:label "Quoted Price"@en .


:OverallCostEstimateForQuotation rdf:type owl:Class ;
    rdfs:subClassOf gist:Magnitude ;
    rdfs:label "Over all cost Estimate for the quotation"@en ;
    rdfs:comment "The total estimated per unit cost value for a quotation, most often representing the effective factory door price per unit."@en .

:CostEstimateForEachCostRuleTemplateApplicableToAQuotation rdf:type owl:Class ;
    rdfs:subClassOf gist:Magnitude ;
    rdfs:label "Cost Estimate"@en ;
    rdfs:comment "An estimated cost value for each appliable cost rule template applicable to the quotation."@en .

:CostComponentsApplicableToAQuotation rdf:type owl:Class ;
    rdfs:subClassOf gist:Information ;
    rdfs:label "Cost Components of a Quotation."@en ;
    rdfs:comment "All the cost components that are applicble to the quotation."@en .

:CostRuleTemplatesApplicableToAQuotation rdf:type owl:Class ;
    rdfs:subClassOf gist:Information ;
    rdfs:label "Cost rule templates applicable to a Quotation."@en ;
    rdfs:comment "All the Cost rules templates applicable to a Quotation."@en .



#################################################################
# Quotation Comparison Assessment
#################################################################

:QuotationComparisonAssessment rdf:type owl:Class ;
    rdfs:subClassOf gist:Assessment ;
    rdfs:label "Quotation Comparison Assessment"@en ;
    rdfs:comment "An assessment comparing multiple supplier quotations for the same material and quantity, resulting in an evaluated effective price, ranking, and recommendation."@en .



#################################################################
#    Classes (Quotation) - End
#################################################################

#################################################################
#    Object Properties - (Quotation) - Begin
#################################################################


:quotedForMaterial rdf:type owl:ObjectProperty ;
    rdfs:domain :Quotation ;
    rdfs:range :MaterialRequiredForProduction ;
    rdfs:label "quoted for material"@en .

:quotedQuantity rdf:type owl:ObjectProperty ;
    rdfs:domain :Quotation ;
    rdfs:range gist:Magnitude ;
    rdfs:label "quoted quantity"@en .

:hasIncoterm rdf:type owl:ObjectProperty ;
    rdfs:domain :Quotation ;
    rdfs:range :Incoterm ;
    rdfs:label "has incoterm"@en .


:hasShipmentMode rdf:type owl:ObjectProperty ;
    rdfs:domain :Quotation ;
    rdfs:range :ShipmentMode ;
    rdfs:label "has shipment mode"@en .



:hasCostComponentsApplicableToAQuotation rdf:type owl:ObjectProperty ;
    rdfs:domain :Quotation ;
    rdfs:range :CostComponentsApplicableToAQuotation ;
    rdfs:label "quotation has applicable cost components"@en .


:hasCostRuleTemplatesApplicableToAQuotation rdf:type owl:ObjectProperty ;
    rdfs:domain :Quotation ;
    rdfs:range :CostRuleTemplatesApplicableToAQuotation ;
    rdfs:label "cost rules applicable to cost components that are applicable to a quotation "@en .


:hasCostEstimateForEachCostRuleTemplateApplicableToAQuotation rdf:type owl:ObjectProperty ;
    rdfs:domain :CostEstimateForEachCostRuleTemplateApplicableToAQuotation ;
    rdfs:range :CostRuleTemplatesApplicableToAQuotation ;
    rdfs:label "cost estimate for each cost rule that is applicable to the cost components that are applicable to a quotation "@en .


:deliveryDestination rdf:type owl:ObjectProperty ;
    rdfs:domain :Quotation ;
    rdfs:range gist:GeoLocation  ;
    rdfs:label "delivery destination"@en ;
    rdfs:comment "Destination up to which the supplier is responsible under the quotation (plant, port, or other location)."@en .

:hasLogisticsRoute rdf:type owl:ObjectProperty ;
    rdfs:domain :Quotation ;
    rdfs:range :LogisticsRoute ;
    rdfs:label "has logistics route"@en .

:hasQuotedPrice rdf:type owl:ObjectProperty ;
    rdfs:domain :Quotation ;
    rdfs:range :QuotedPrice ;
    rdfs:label "has quoted price"@en .

###The source document of quotation is defined in foundational section at the beginning.
###Quotation has a time period in which it is valid. This is defined by TemporalExtent, which is defined at the beginningof this document.
###Also see applicablePlant to se the own factory and quoation link.

:assessesQuotation rdf:type owl:ObjectProperty ;
    rdfs:domain :QuotationComparisonAssessment ;
    rdfs:range :Quotation ;
    rdfs:label "assesses quotation"@en .

:hasOverallCostEstimateForQuotation rdf:type owl:ObjectProperty ;
    rdfs:domain :Quotation ;
    rdfs:range :OverallCostEstimateForQuotation ;
    rdfs:label "has effective factory door price"@en .



#################################################################
#    Object Properties - (Quotation) - End
#################################################################

#################################################################
#    Data Properties - (Quotation) - Begin
#################################################################

:quotationDateTime rdf:type owl:DatatypeProperty ;
				  rdfs:domain :Quotation ;
				  rdfs:range  xsd:dateTime ;
				  rdfs:label "Quotation dateTime" ;
				  rdfs:comment "The date and time at which the Quotation was received from supplier." .
