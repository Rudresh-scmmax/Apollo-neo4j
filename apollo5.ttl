# Data properties - Summary of Procurement History - End
#################################################################





#################################################################
#    Classes - (Material Quality Parameters) - Begin
#################################################################
###  http://www.apollo-procurement.org/ontology#TensileStrength
:QualityAspect rdf:type owl:Class ;
				  rdfs:subClassOf gist:Aspect ;
				  rdfs:label "Quality Aspect"@en ;
				  rdfs:comment "A measurable or assessable quality dimension of a material or supplier product, such as purity, pH, viscosity, color, or impurity level."@en .

		  
:PurityAspect rdf:type owl:Class ;
                  rdfs:subClassOf :QualityAspect ;
                  rdfs:comment "Quality aspect representing purity or assay (e.g., % active, % glycerol)" ;
				  rdfs:label "Purity"@en .

:ImpurityAspect rdf:type owl:Class ;
                  rdfs:subClassOf :QualityAspect ;
                  rdfs:comment "Quality aspects representing impurities or contaminants (e.g., water, chloride, heavy metals)." ;
				  rdfs:label "Impurity"@en .
				  
:AshAspect rdf:type owl:Class ;
                  rdfs:subClassOf :QualityAspect ;
                  rdfs:comment "Quality aspect representing inorganic residue (ash) (% w/w)" ;
				  rdfs:label "Ash %"@en .
				  
:WaterContentAspect rdf:type owl:Class ;
                  rdfs:subClassOf :QualityAspect ;
                  rdfs:comment "Quality aspect representing water content (% w/w) in" ;
				  rdfs:label "Water Content"@en .
				  

:FreezingPointAspect rdf:type owl:Class ;
                  rdfs:subClassOf :QualityAspect ;
                  rdfs:comment "Quality aspect representing freezing point (°C) " ;
				  rdfs:label "Freezing Point"@en .


:HLBValueAspect rdf:type owl:Class ;
                  rdfs:subClassOf :QualityAspect ;
                  rdfs:comment "Quality Aspect representing HLB value (dimensionless) for emulsification/detergency " ;
				  rdfs:label "HLB Value"@en .
				  
:phValueAspect rdf:type owl:Class ;
                  rdfs:subClassOf :QualityAspect ;
                  rdfs:comment "Quality Aspect representing ph " ;
				  rdfs:label "pH Value"@en .

:QualitySpecification rdf:type owl:Class ;
    rdfs:subClassOf gist:Specification ;
    rdfs:label "Quality Specification"@en ;
    rdfs:comment "A formal requirement that defines acceptable limits or conditions for a specific quality aspect of a material or supplier product. A Quality Specification represents what is required, not what was observed."@en .


:QCMeasurement rdf:type owl:Class ;
				   rdfs:subClassOf gist:Event ;
				   rdfs:label "Quality Control Measurement"@en ;
				   rdfs:comment "An event in which a quality aspect of a material or supplier product is measured, producing an observed value with a unit of measure.QCMeasurement captures when, where, and on which sample the measurementwas performed."@en .


:ResultCategory rdf:type owl:Class ;
    rdfs:subClassOf gist:Category ;
    rdfs:label "Result Category"@en ;
    rdfs:comment "A controlled category representing a qualitative outcome of a quality control measurement or evaluation, used when results are not numeric (e.g., pass/fail, acceptable/unacceptable)."@en .

#################################################################
# ResultCategory — instances / values - Begin
#################################################################

:Pass rdf:type :ResultCategory ;
    rdfs:label "Pass"@en ;
    rdfs:comment "Indicates that the material meets the specified quality requirement or acceptance criterion."@en .

:Fail rdf:type :ResultCategory ;
    rdfs:label "Fail"@en ;
    rdfs:comment "Indicates that the material does not meet the specified quality requirement or acceptance criterion."@en .

:NotTested rdf:type :ResultCategory ;
    rdfs:label "Not Tested"@en ;
    rdfs:comment "Indicates that the quality test was not performed or data is unavailable."@en .

#################################################################
# ResultCategory — instances / values - End
#################################################################





:ComparisonOperator rdf:type owl:Class ;
    rdfs:subClassOf gist:Category ;
    rdfs:label "Comparison Operator"@en ;
    rdfs:comment "A controlled category representing a logical or mathematical operator used to compare a measured value against a specified criterion."@en .


#################################################################
# ComparisonOperator — instances / values - Begin
#################################################################

:GreaterThan rdf:type :ComparisonOperator ;
    rdfs:label "Greater Than (>)"@en ;
    rdfs:comment "Indicates that the measured value must be strictly greater than the specified threshold."@en .

:GreaterThanOrEqualTo rdf:type :ComparisonOperator ;
    rdfs:label "Greater Than or Equal To (≥)"@en ;
    rdfs:comment "Indicates that the measured value must be greater than or equal to the specified threshold."@en .

:LessThan rdf:type :ComparisonOperator ;
    rdfs:label "Less Than (<)"@en ;
    rdfs:comment "Indicates that the measured value must be strictly less than the specified threshold."@en .

:BetweenInclusive rdf:type :ComparisonOperator ;
    rdfs:label "Between (Inclusive)"@en ;
    rdfs:comment "Indicates that the measured value must lie within a specified range, including both lower and upper bounds."@en .


#################################################################
# ComparisonOperator — instances / values - End
#################################################################


#################################################################
#    Classes - (Material Quality Parameters) - End
#################################################################

#################################################################
#    Object Properties - (Material Quality Parameters - Aspect) - Begin
#################################################################

###  http://www.apollo-procurement.org/ontology#QualityAspect
:hasQualityAspect rdf:type owl:ObjectProperty ;
                  rdfs:domain :MaterialRequiredForProduction ;
                  rdfs:range :QualityAspect ;
                  rdfs:comment "Links a Supplier Product to a quality aspect that can be measured( eg. purity water content, phValue etc)."@en ;
                  rdfs:label "has quality aspect"@en .


#################################################################
#    Object Properties - (Material Quality Parameters - Aspect) - End
#################################################################


#################################################################
#    Object Properties - (Material Quality Parameters - QCMeasurement) - Begin
#################################################################

  
:measuresMaterial rdf:type owl:ObjectProperty ;
				  rdfs:domain :QCMeasurement ;
				  rdfs:range  :SupplierProduct ;
				  rdfs:label "measures material" ;
				  rdfs:comment "Links a QC measurement to the specific supplier raw material (or sample) it measures." .

:forAspect rdf:type owl:ObjectProperty ;
				  rdfs:domain :QCMeasurement ;
				  rdfs:range  :QualityAspect ;
				  rdfs:label "for aspect" ;
				  rdfs:comment "Indicates which quality aspect a QC measurement is about (purity, water content, etc.)." .

###    Magnitude for QCMeasurement is  defined under :hasMagnitude right at the beginning

:hasResultCategory rdf:type owl:ObjectProperty ;
				  rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( :QCMeasurement :QualitySpecification ) ] ;
				  rdfs:range :ResultCategory ; 
				  rdfs:label "has qualitative result category"@en ; 
				  rdfs:comment "Associates either a quality specification or a QC measurement with a qualitative or categorical result, such as pass/fail, acceptable/ unacceptable, or conforms/does not conform. For QualitySpecification, this represents the required outcome. For QCMeasurement, this represents the observed outcome."@en .


:performedAt rdf:type owl:ObjectProperty ;
				  rdfs:domain :QCMeasurement ; 
				  rdfs:range :OwnManufacturingPlant ; 
				  rdfs:label "performed at"@en ; 
				  rdfs:comment "Indicates the factory or laboratory where the QC measurement was performed."@en .



#################################################################
#    Object Properties - (Material Quality Parameters - QCMeasurement) - End
#################################################################

#################################################################
#    Object Properties - (Material Quality Parameters - Specification) - Begin
#################################################################

:specifiesAspect rdf:type owl:ObjectProperty ;
                  rdfs:domain :QualitySpecification ;
				  rdfs:range :QualityAspect ;
				  rdfs:label "specifies quality aspect"@en ;
				  rdfs:comment "Indicates the quality aspect (e.g., purity, pH, viscosity) to which this quality specification applies."@en .

:appliesToMaterial rdf:type owl:ObjectProperty ;
				  rdfs:domain :QualitySpecification ;
				  rdfs:range :MaterialRequiredForProduction ;
				  rdfs:label "applies to material or product"@en ;
				  rdfs:comment "Indicates the material or supplier product to which this quality specification applies."@en .


:applicableFactory rdf:type owl:ObjectProperty ;
				  rdfs:domain :QualitySpecification ;
				  rdfs:range :OwnManufacturingPlant ;
				  rdfs:label "applicable factory"@en ;
				  rdfs:comment "Indicates the manufacturing plant or factory where this quality specification applies. Allows factory-specific acceptance criteria."@en .

###Also see hasResultCategory above for qualitative results



:hasThresholdMagnitude rdf:type owl:ObjectProperty ;
				  rdfs:domain :QualitySpecification ; 
				  rdfs:range gist:Magnitude ; 
				  rdfs:label "has threshold magnitude"@en ; 
				  rdfs:comment "Specifies the numeric threshold value and unit that defines the acceptable limit for a quality aspect."@en .


:hasLowerBoundMagnitude rdf:type owl:ObjectProperty ;
				  rdfs:domain :QualitySpecification ;
				  rdfs:range gist:Magnitude ;
				  rdfs:label "has lower bound magnitude"@en ;
				  rdfs:comment "Specifies the lower bound of an acceptable numeric range for a quality aspect."@en .


:hasUpperBoundMagnitude rdf:type owl:ObjectProperty ;
				  rdfs:domain :QualitySpecification ;
				  rdfs:range gist:Magnitude ;
				  rdfs:label "has upper bound magnitude"@en ;
				  rdfs:comment "Specifies the upper bound of an acceptable numeric range for a quality aspect."@en .


:hasComparisonOperator rdf:type owl:ObjectProperty ;
				  rdfs:domain :QualitySpecification ;
				  rdfs:range :ComparisonOperator ;
				  rdfs:label "has comparison operator"@en ;
				  rdfs:comment "Indicates how the measured value should be compared to the threshold, such as greater than or equal to, between, equal to, or approximately equal to."@en .

######    Quality Specification Valid from and Valid to dates are defined under :hasTemporalExtent right at the beginning

#################################################################
#    Object Properties - (Material Quality Parameters - Specification) - End
#################################################################

#################################################################
#    Data Properties - (Material Properties) - Begin
#################################################################


:measurementDateTime rdf:type owl:DatatypeProperty ;
				  rdfs:domain :QCMeasurement ;
				  rdfs:range  xsd:dateTime ;
				  rdfs:label "measurement dateTime" ;
				  rdfs:comment "The date and time at which the QC measurement was performed." .


#################################################################
#    Data Properties - (Material Properties) - End
#################################################################


