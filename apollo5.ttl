:SoybeanOil rdf:type owl:NamedIndividual ,
                     :RawMaterialofMaterialRequiredForProduction ;
            :belongsToChemistryGroup :VegetableOil ;
            :belongsToEndUseGroup :BiofuelFeedstock ;
