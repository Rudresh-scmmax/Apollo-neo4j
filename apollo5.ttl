###  http://www.apollo-procurement.org/ontology#Event_China_ExportControls_Jan26
:Event_China_ExportControls_Jan26 rdf:type owl:NamedIndividual ,
                                           :SupplyDisruptionEvent ;
                                  :affectsMaterial :GlycerineRefined ;
                                  :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                       <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2026-03-31T00:00:00Z"^^xsd:dateTime ;
                                                       <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2026-01-10T00:00:00Z"^^xsd:dateTime
                                                     ] ;
                                  rdfs:comment "The Chinese Ministry of Commerce introduced glycerine export licensing requirements in January 2026 as part of a broader review of strategic chemical export controls. The measure effectively delayed Chinese glycerine exports by 4-6 weeks while producers applied for licences, removing a significant volume of supply from global markets at a time of already constrained availability and supporting prices."@en ;
                                  rdfs:label "China Glycerine Export Licensing Controls — Jan 2026"@en .


###  http://www.apollo-procurement.org/ontology#Event_Godrej_LaborStrike_Mar25
:Event_Godrej_LaborStrike_Mar25 rdf:type owl:NamedIndividual ,
                                         :SupplyDisruptionEvent ;
                                :affectsMaterial :GlycerineRefined ;
                                :hasLocation :Region_WestIndia ;
                                :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                     <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2025-03-20T00:00:00Z"^^xsd:dateTime ;
                                                     <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2025-03-08T00:00:00Z"^^xsd:dateTime
                                                   ] ;
                                :involvesOrganization :GodrejIndustries ;
                                rdfs:comment "A labour union dispute at Godrej Industries Valia plant resulted in a 12-day work stoppage starting March 8, 2025. The entire oleochemical production line including glycerine refining was suspended. The disruption coincided with the US tariff announcement, amplifying market tightness."@en ;
                                rdfs:label "Godrej Industries Valia Plant — Labour Dispute Shutdown"@en .


###  http://www.apollo-procurement.org/ontology#Event_IOI_NewLine_2026
:Event_IOI_NewLine_2026 rdf:type owl:NamedIndividual ,
                                 :CapacityAdditionEvent ;
                        :affectsMaterial :GlycerineRefined ;
                        :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                             <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2026-09-30T00:00:00Z"^^xsd:dateTime ;
                                             <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2026-07-01T00:00:00Z"^^xsd:dateTime
                                           ] ;
                        :involvesOrganization :IOIOleochemicals ;
                        rdfs:comment "IOI Oleochemicals adding a third glycerine distillation column at Prai adding approximately 8,000 MT/yr, targeting pharmaceutical-grade output. Start-up planned Q3 2026."@en ;
                        rdfs:label "IOI Oleochemicals Prai New Glycerine Distillation Line — 2026"@en .


###  http://www.apollo-procurement.org/ontology#Event_IOI_Prai_BoilerFailure_Jun24
:Event_IOI_Prai_BoilerFailure_Jun24 rdf:type owl:NamedIndividual ,
                                             :SupplyDisruptionEvent ;
                                    :affectsMaterial :GlycerineRefined ;
                                    :hasLocation :Region_PeninsularMalaysia ;
                                    :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                         <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2024-06-22T00:00:00Z"^^xsd:dateTime ;
                                                         <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2024-06-04T00:00:00Z"^^xsd:dateTime
                                                       ] ;
                                    :involvesOrganization :IOIOleochemicals ;
                                    rdfs:comment "A high-pressure steam boiler failure at IOI's Prai plant in June 2024 forced a partial shutdown of the glycerine distillation unit for 18 days while the boiler was inspected and repaired. Output reduced to approximately 40% of nameplate during the outage."@en ;
                                    rdfs:label "IOI Oleochemicals Prai — Steam Boiler Failure Partial Shutdown"@en .


###  http://www.apollo-procurement.org/ontology#Event_India_BiodieselPolicy_Jan25
:Event_India_BiodieselPolicy_Jan25 rdf:type owl:NamedIndividual ,
                                            :SupplyDisruptionEvent ;
                                   :affectsMaterial :GlycerineRefined ;
                                   :hasLocation :India_Gujarat ;
                                   :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                        <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2025-06-30T00:00:00Z"^^xsd:dateTime ;
                                                        <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2025-01-15T00:00:00Z"^^xsd:dateTime
                                                      ] ;
                                   rdfs:comment "In January 2025, the Indian government revised the National Biofuel Policy, reducing the mandatory biodiesel blending target from 5% to 3.5% due to feedstock cost pressures. The revision reduced biodiesel throughput at Indian esterification plants and consequently reduced glycerine co-production output by an estimated 12-15% industry-wide. This tightened domestic glycerine availability and pushed prices upward."@en ;
                                   rdfs:label "India Biodiesel Blending Policy Revision — Reduced Glycerine Co-production"@en .


###  http://www.apollo-procurement.org/ontology#Event_India_Heatwave_PlantShutdown_May23
:Event_India_Heatwave_PlantShutdown_May23 rdf:type owl:NamedIndividual ,
                                                   :SupplyDisruptionEvent ;
                                          :affectsMaterial :GlycerineRefined ;
                                          :hasLocation :India_Gujarat ;
                                          :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                               <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2023-06-05T00:00:00Z"^^xsd:dateTime ;
                                                               <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2023-05-10T00:00:00Z"^^xsd:dateTime
                                                             ] ;
                                          :involvesOrganization :VadilalChemicalsLimited ;
                                          rdfs:comment "Extreme heat (47–50°C) across Gujarat in May 2023 triggered state grid power rationing. Vadilal Chemicals Mundra plant operated at reduced capacity (est. 60%) for approximately 3 weeks due to mandatory load-shedding schedules affecting continuous-process glycerine refining."@en ;
                                          rdfs:label "India Heatwave Power Rationing — Vadilal Chemicals Mundra Reduced Output"@en .


###  http://www.apollo-procurement.org/ontology#Event_KLK_PasirGudang_Fire_May24
:Event_KLK_PasirGudang_Fire_May24 rdf:type owl:NamedIndividual ,
                                           :SupplyDisruptionEvent ;
                                  :affectsMaterial :GlycerineRefined ;
                                  :hasLocation :Malaysia_PeninsularWest ;
                                  :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                       <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2024-06-28T00:00:00Z"^^xsd:dateTime ;
                                                       <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2024-05-14T00:00:00Z"^^xsd:dateTime
                                                     ] ;
                                  :involvesOrganization :KLKOleo ;
                                  rdfs:comment "A fire broke out in the glycerine distillation unit at KLK Oleo's Pasir Gudang refinery in Johor, Malaysia in mid-May 2024. The unit was shut down for safety inspection and repairs for approximately 6 weeks. KLK Oleo declared force majeure on affected glycerine supply contracts."@en ;
                                  rdfs:label "KLK Oleo Pasir Gudang Refinery — Fire Incident Plant Shutdown"@en .


###  http://www.apollo-procurement.org/ontology#Event_Malaysia_Floods_Mar24
:Event_Malaysia_Floods_Mar24 rdf:type owl:NamedIndividual ,
                                      :ForceMajeureEvent ;
                             :affectsMaterial :CrudePalmOil ,
                                              :GlycerineRefined ;
                             :hasLocation :Malaysia_PeninsularWest ,
                                          :Malaysia_Sabah ;
                             :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                  <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2024-04-05T00:00:00Z"^^xsd:dateTime ;
                                                  <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2024-03-02T00:00:00Z"^^xsd:dateTime
                                                ] ;
                             :involvesOrganization :EmeryOleochemicals ,
                                                   :KLKOleo ;
                             rdfs:comment "Simultaneous flash flooding events in Sabah (east Malaysia) and Johor (Peninsular Malaysia) in early March 2024 disrupted palm oil FFB collection, milling, and oleochemical refinery logistics. KLK Oleo and Emery Oleochemicals reported reduced glycerine production volumes for 3-4 weeks as feedstock delivery was interrupted."@en ;
                             rdfs:label "Malaysia Flash Floods — Sabah and Johor Palm Oil & Oleochemical Disruption"@en .


###  http://www.apollo-procurement.org/ontology#Event_Malaysia_LaNina_Floods_Nov25
:Event_Malaysia_LaNina_Floods_Nov25 rdf:type owl:NamedIndividual ,
                                             :ForceMajeureEvent ;
                                    :affectsMaterial :CrudePalmOil ,
                                                     :GlycerineRefined ;
                                    :hasLocation :Malaysia_Sabah ;
                                    :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                         <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2025-12-20T00:00:00Z"^^xsd:dateTime ;
                                                         <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2025-11-05T00:00:00Z"^^xsd:dateTime
                                                       ] ;
                                    :involvesOrganization :KLKOleo ;
                                    rdfs:comment "La Niña conditions in November 2025 brought exceptionally heavy rainfall to Sabah, Malaysia. Extensive flooding disrupted palm oil FFB (Fresh Fruit Bunch) collection and road transport across the Kinabatangan and Sandakan corridors, reducing oleochemical feedstock throughput. KLK Oleo advised customers of reduced glycerine availability through year-end."@en ;
                                    rdfs:label "La Niña Flooding — Sabah Malaysia Palm Oil and Glycerine Supply Disruption"@en .


###  http://www.apollo-procurement.org/ontology#Event_Mindanao_Earthquake_Jul24
:Event_Mindanao_Earthquake_Jul24 rdf:type owl:NamedIndividual ,
                                          :ForceMajeureEvent ;
                                 :affectsMaterial :GlycerineRefined ;
                                 :hasLocation :Philippines_Mindanao ;
                                 :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                      <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2024-07-28T00:00:00Z"^^xsd:dateTime ;
                                                      <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2024-07-12T00:00:00Z"^^xsd:dateTime
                                                    ] ;
                                 rdfs:comment "A magnitude 6.9 earthquake struck offshore Mindanao on 12 July 2024, triggering a 72-hour tsunami advisory and suspension of port operations at Davao International Container Terminal. Oleochemical shipment queues were delayed; several glycerine tanks were inspected for structural integrity before resuming loading operations."@en ;
                                 rdfs:label "M6.9 Earthquake Mindanao — Davao Port Operations Suspended"@en .


###  http://www.apollo-procurement.org/ontology#Event_MusimMas_Batam_Outage_Sep25
:Event_MusimMas_Batam_Outage_Sep25 rdf:type owl:NamedIndividual ,
                                            :SupplyDisruptionEvent ;
                                   :affectsMaterial :GlycerineRefined ;
                                   :hasLocation :Indonesia_Sumatra ;
                                   :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                        <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2025-10-10T00:00:00Z"^^xsd:dateTime ;
                                                        <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2025-09-08T00:00:00Z"^^xsd:dateTime
                                                      ] ;
                                   :involvesOrganization :MusimMas ;
                                   rdfs:comment "Musim Mas Group's Batam Island oleochemical refinery experienced an unplanned shutdown in September 2025 following a heat exchanger failure in the glycerine purification train. The refinery declared force majeure on glycerine supply contracts. Repairs and restart took approximately 4 weeks."@en ;
                                   rdfs:label "Musim Mas Batam Refinery — Unplanned Outage (Equipment Failure)"@en .


###  http://www.apollo-procurement.org/ontology#Event_Olin_Freeport_FM
:Event_Olin_Freeport_FM rdf:type owl:NamedIndividual ,
                                 :SupplyDisruptionEvent ;
                        :affectsMaterial :Acetone ;
                        :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                             <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2025-08-01T00:00:00Z"^^xsd:dateTime
                                           ] ;
                        :involvesOrganization :OlinCorporation ;
                        rdfs:comment "Olin declared force majeure on acetone and phenol at its Freeport, Texas site."@en ;
                        rdfs:label "Olin Force Majeure at Freeport"@en .


###  http://www.apollo-procurement.org/ontology#Event_Pakistan_Karachi_LogisticsDisruption_Jul23
:Event_Pakistan_Karachi_LogisticsDisruption_Jul23 rdf:type owl:NamedIndividual ,
                                                           :SupplyDisruptionEvent ;
                                                  :affectsMaterial :GlycerineRefined ;
                                                  :hasLocation :India_Gujarat ;
                                                  :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                                       <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2023-08-20T00:00:00Z"^^xsd:dateTime ;
                                                                       <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2023-07-15T00:00:00Z"^^xsd:dateTime
                                                                     ] ;
                                                  rdfs:comment "Severe monsoon flooding in Sindh province and Karachi hinterland in July 2023 caused severe congestion and dwell-time increases at Karachi port (PoKCT and QICT terminals), disrupting glycerine import clearances for buyers in Pakistan and onward trans-shipment to Indian west coast ports."@en ;
                                                  rdfs:label "Pakistan Monsoon Floods — Karachi Port Logistics Disruption"@en .


###  http://www.apollo-procurement.org/ontology#Event_RedSea_Houthi_Shipping_Nov23
:Event_RedSea_Houthi_Shipping_Nov23 rdf:type owl:NamedIndividual ,
                                             :SupplyDisruptionEvent ;
                                    :affectsMaterial :GlycerineRefined ;
                                    :hasLocation :RedSea_Region ;
                                    :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                         <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2024-06-30T00:00:00Z"^^xsd:dateTime ;
                                                         <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2023-11-19T00:00:00Z"^^xsd:dateTime
                                                       ] ;
                                    rdfs:comment "From November 2023, Houthi militia attacks on commercial vessels in the Red Sea and Bab-el-Mandeb strait forced major container lines (Maersk, MSC, CMA CGM) to re-route via the Cape of Good Hope. Glycerine shipments from SE Asia to Europe and India via Suez Canal were delayed by 10–14 additional days and subject to war risk surcharges of USD 200–400/TEU."@en ;
                                    rdfs:label "Houthi Attacks — Red Sea Shipping Disruption (Glycerine Routes)"@en .


###  http://www.apollo-procurement.org/ontology#Event_RedSea_Ongoing_Sep24
:Event_RedSea_Ongoing_Sep24 rdf:type owl:NamedIndividual ,
                                     :SupplyDisruptionEvent ;
                            :affectsMaterial :GlycerineRefined ;
                            :hasLocation :RedSea_Region ;
                            :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                 <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2024-12-31T00:00:00Z"^^xsd:dateTime ;
                                                 <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2024-09-01T00:00:00Z"^^xsd:dateTime
                                               ] ;
                            rdfs:comment "Red Sea conflict-related re-routing continued into H2 2024 with no resolution in sight. By September 2024 all major lines were still avoiding the Bab-el-Mandeb. Glycerine transit times from SE Asia to Indian west coast ports remained 12-15 days longer than the pre-conflict baseline, with freight rates 60-80% above pre-disruption levels."@en ;
                            rdfs:label "Red Sea Disruption — Persistent Freight Premium on Glycerine Routes (Sep 2024)"@en .


###  http://www.apollo-procurement.org/ontology#Event_SE_Asia_Monsoons_Nov25
:Event_SE_Asia_Monsoons_Nov25 rdf:type owl:NamedIndividual ,
                                       :ForceMajeureEvent ;
                              :affectsMaterial :CrudePalmOil ;
                              :hasLocation :SE_Asia_Region ;
                              rdfs:comment "Heavy monsoon rains and floods disrupting upstream palm oil supplies in Indonesia, Malaysia, Thailand, and Vietnam."@en ;
                              rdfs:label "SE Asia Monsoon Rains & Floods"@en .


###  http://www.apollo-procurement.org/ontology#Event_Sumatra_Earthquake_May25
:Event_Sumatra_Earthquake_May25 rdf:type owl:NamedIndividual ,
                                         :ForceMajeureEvent ;
                                :affectsMaterial :CrudePalmOil ,
                                                 :GlycerineRefined ;
                                :hasLocation :Indonesia_Sumatra ;
                                :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                     <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2025-06-30T00:00:00Z"^^xsd:dateTime ;
                                                     <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2025-05-09T00:00:00Z"^^xsd:dateTime
                                                   ] ;
                                :involvesOrganization :MusimMas ;
                                rdfs:comment "A magnitude 7.1 earthquake struck North Sumatra in May 2025 with an epicentre near the Medan-Belawan industrial corridor, home to several palm oil refining and oleochemical complexes. Structural damage and precautionary evacuation caused plant shutdowns at two major glycerine co-production units. Full restart took 5-8 weeks including engineering inspections."@en ;
                                rdfs:label "M7.1 Earthquake North Sumatra — Medan Industrial Zone Plant Shutdowns"@en .


###  http://www.apollo-procurement.org/ontology#Event_Sumatra_Flood_Mar23
:Event_Sumatra_Flood_Mar23 rdf:type owl:NamedIndividual ,
                                    :ForceMajeureEvent ;
                           :affectsMaterial :CrudePalmOil ,
                                            :GlycerineRefined ;
                           :hasLocation :Indonesia_Sumatra ;
                           :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2023-04-15T00:00:00Z"^^xsd:dateTime ;
                                                <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2023-03-05T00:00:00Z"^^xsd:dateTime
                                              ] ;
                           :involvesOrganization :MusimMas ;
                           rdfs:comment "Unusually heavy rainfall and flash flooding in the Lake Toba basin disrupted palm oil mill operations across North Sumatra in March 2023, reducing crude palm oil throughput and thereby glycerine co-production volumes at downstream oleochemical refineries."@en ;
                           rdfs:label "North Sumatra Lake Toba Basin Flooding — Mar 2023"@en .


###  http://www.apollo-procurement.org/ontology#Event_TOL_CycloneYagi_Oct25
:Event_TOL_CycloneYagi_Oct25 rdf:type owl:NamedIndividual ,
                                      :ForceMajeureEvent ;
                             :affectsMaterial :GlycerineRefined ;
                             :hasLocation :Region_PeninsularMalaysia ;
                             :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                  <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2025-10-22T00:00:00Z"^^xsd:dateTime ;
                                                  <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2025-10-01T00:00:00Z"^^xsd:dateTime
                                                ] ;
                             :involvesOrganization :ThaiOleochemicals ;
                             rdfs:comment "Cyclone Yagi made landfall over the Gulf of Thailand in late September 2025. Though the Map Ta Phut complex was not directly struck, storm surge and logistics disruption around Laem Chabang port caused a 3-week operational delay at Thai Oleochemicals, reducing glycerine shipments."@en ;
                             rdfs:label "Thai Oleochemicals Map Ta Phut — Cyclone Yagi Aftermath Operational Delay"@en .


###  http://www.apollo-procurement.org/ontology#Event_Thailand_Floods_Jul25
:Event_Thailand_Floods_Jul25 rdf:type owl:NamedIndividual ,
                                      :ForceMajeureEvent ;
                             :affectsMaterial :GlycerineRefined ;
                             :hasLocation :Thailand_Central ;
                             :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                  <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2025-08-25T00:00:00Z"^^xsd:dateTime ;
                                                  <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2025-07-18T00:00:00Z"^^xsd:dateTime
                                                ] ;
                             rdfs:comment "Unusually intense monsoon rainfall inundated the Chao Phraya basin in July 2025, flooding industrial estates in Pathum Thani and Ayutthaya provinces. Two biodiesel production facilities with glycerine co-production capacity were shut down due to flood water ingress. Combined glycerine output from the affected plants represented approximately 8,000 MT per month."@en ;
                             rdfs:label "Central Thailand Flash Floods — Biodiesel Plant Shutdowns"@en .


###  http://www.apollo-procurement.org/ontology#Event_Turkey_Earthquake_Feb23
:Event_Turkey_Earthquake_Feb23 rdf:type owl:NamedIndividual ,
                                        :ForceMajeureEvent ;
                               :affectsMaterial :GlycerineRefined ;
                               :hasLocation :Turkey_Iskenderun ;
                               :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                    <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2023-03-31T00:00:00Z"^^xsd:dateTime ;
                                                    <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2023-02-06T00:00:00Z"^^xsd:dateTime
                                                  ] ;
                               rdfs:comment "The 7.8 magnitude earthquake on 6 Feb 2023 severely damaged container handling infrastructure at Iskenderun port, a key export point for Turkish oleochemicals and glycerine transshipment routes into the Indian Ocean. Re-routing to Mersin added 7-10 days of freight lead time."@en ;
                               rdfs:label "Kahramanmaraş Earthquake — Iskenderun Port Disruption"@en .


###  http://www.apollo-procurement.org/ontology#Event_Typhoon_Mawar_Philippines_Sep23
:Event_Typhoon_Mawar_Philippines_Sep23 rdf:type owl:NamedIndividual ,
                                                :ForceMajeureEvent ;
                                       :affectsMaterial :GlycerineRefined ;
                                       :hasLocation :Philippines_Mindanao ;
                                       :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                            <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2023-11-01T00:00:00Z"^^xsd:dateTime ;
                                                            <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2023-09-22T00:00:00Z"^^xsd:dateTime
                                                          ] ;
                                       rdfs:comment "Super Typhoon Mawar (category 4 equivalent at Philippine landfall) struck the Davao Gulf region of Mindanao in late September 2023, directly impacting coconut oil and palm kernel oil processing facilities. Several glycerine co-production units at Davao-based oleochemical plants were shut down for 4–6 weeks for structural assessment and repairs."@en ;
                                       rdfs:label "Super Typhoon Mawar — Mindanao Oleochemical Corridor Disruption"@en .


###  http://www.apollo-procurement.org/ontology#Event_US_Tariffs_IndianOleochemicals_Mar25
:Event_US_Tariffs_IndianOleochemicals_Mar25 rdf:type owl:NamedIndividual ,
                                                     :SupplyDisruptionEvent ;
                                            :affectsMaterial :GlycerineRefined ;
                                            :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                                 <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2025-09-30T00:00:00Z"^^xsd:dateTime ;
                                                                 <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2025-03-15T00:00:00Z"^^xsd:dateTime
                                                               ] ;
                                            :involvesOrganization :VadilalChemicalsLimited ;
                                            rdfs:comment "The US administration imposed 25% tariffs on Indian oleochemical exports including glycerine under Section 232 (national security) provisions in March 2025. While India-to-US glycerine flows are modest, the tariff announcement triggered buyer uncertainty globally, with some Indian producers diverting export volumes to Asian and Middle Eastern markets, tightening supply available for direct import into Europe."@en ;
                                            rdfs:label "US Section 232 Tariffs — Indian Oleochemicals and Glycerine Export Disruption"@en .


###  http://www.apollo-procurement.org/ontology#Event_Vadilal_Mundra_Maintenance_Jan24
:Event_Vadilal_Mundra_Maintenance_Jan24 rdf:type owl:NamedIndividual ,
                                                 :SupplyDisruptionEvent ;
                                        :affectsMaterial :GlycerineRefined ;
                                        :hasLocation :India_Gujarat ;
                                        :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                             <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2024-01-26T00:00:00Z"^^xsd:dateTime ;
                                                             <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2024-01-05T00:00:00Z"^^xsd:dateTime
                                                           ] ;
                                        :involvesOrganization :VadilalChemicalsLimited ;
                                        rdfs:comment "Vadilal Chemicals undertook a scheduled 21-day plant turnaround at its Mundra, Gujarat refinery in January 2024. The shutdown covered the glycerine distillation and purification units. Supply obligations were partially covered from inventory built up in Q4 2023, but spot availability was constrained."@en ;
                                        rdfs:label "Vadilal Chemicals Mundra — Planned Turnaround Maintenance Shutdown"@en .


###  http://www.apollo-procurement.org/ontology#Event_Volcano_Ruang_Nov24
:Event_Volcano_Ruang_Nov24 rdf:type owl:NamedIndividual ,
                                    :ForceMajeureEvent ;
                           :affectsMaterial :CrudePalmOil ,
                                            :GlycerineRefined ;
                           :hasLocation :Indonesia_Sumatra ;
                           :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2024-12-10T00:00:00Z"^^xsd:dateTime ;
                                                <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2024-10-28T00:00:00Z"^^xsd:dateTime
                                              ] ;
                           rdfs:comment "Mount Ruang (North Sulawesi, Indonesia) entered a prolonged eruptive phase from October into November 2024. The associated ash cloud forced temporary closure of Sam Ratulangi International Airport and imposed no-sail zones around the Talaud and Sangihe archipelago. Sulawesi-origin glycerine and CPO shipments were re-routed via Makassar adding 5-8 days of transit time."@en ;
                           rdfs:label "Mount Ruang Eruption — North Sulawesi Shipping Disruption"@en .


###  http://www.apollo-procurement.org/ontology#Event_Wilmar_Dumai_Expansion_2026
:Event_Wilmar_Dumai_Expansion_2026 rdf:type owl:NamedIndividual ,
                                            :CapacityAdditionEvent ;
                                   :affectsMaterial :GlycerineRefined ;
                                   :hasTemporalExtent [ rdf:type <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                        <https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> "2026-06-30T00:00:00Z"^^xsd:dateTime ;
                                                        <https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> "2026-04-01T00:00:00Z"^^xsd:dateTime
                                                      ] ;
                                   :involvesOrganization :WilmarInternational ;
                                   rdfs:comment "Wilmar International is expanding the glycerine distillation train at Dumai, adding approximately 20,000 MT/yr of refined glycerine capacity. Commissioning targeted for Q2 2026."@en ;
                                   rdfs:label "Wilmar Dumai Glycerine Capacity Expansion — 2026"@en .


