#################################################################
#   Object Properties  Incoterms, CostComponent, CostEstimate - Begin
#################################################################
:buyerBearsCost rdf:type owl:ObjectProperty ;
    rdfs:domain :Incoterm ;
    rdfs:range :CostComponent ;
    rdfs:label "buyer bears cost"@en ;
	rdfs:comment "Indicates a cost component that is the responsibility of the buyer under this Incoterm® 2020."@en .

:sellerBearsCost rdf:type owl:ObjectProperty ;
    rdfs:domain :Incoterm ;
    rdfs:range :CostComponent ;
    rdfs:label "seller bears cost"@en ;
	rdfs:comment "Indicates a cost component that is the responsibility of the seller under this Incoterm® 2020."@en .


:forCostComponent rdf:type owl:ObjectProperty ;
    rdfs:domain :CostRuleTemplate ;
    rdfs:range :CostComponent ;
    rdfs:label "for cost component"@en .

:requiresParameter rdf:type owl:ObjectProperty ;
    rdfs:domain :CostRuleTemplate ;
    rdfs:range :CostRuleTemplateParameters ;
    rdfs:label "requires parameter"@en ;
    rdfs:comment "Indicates a required input parameter for evaluating this cost rule template, such as distance, quantity, HSN code, shipment mode, or route."@en .


:responsibilityEndsAt rdf:type owl:ObjectProperty ;
    rdfs:domain :Incoterm ;
    rdfs:range :ResponsibilityBoundary ;
    rdfs:label "responsibility ends at"@en ;
    rdfs:comment "Defines the type of location where seller responsibility ends under this Incoterm, such as export port, import port, or named place."@en .

#################################################################
# responsibilityEndsAt — instances / values - Begin
#################################################################

:CIF :responsibilityEndsAt :ImportPort .
:FOB :responsibilityEndsAt :ExportPort .
:DAP :responsibilityEndsAt :NamedPlace .
:DDP :responsibilityEndsAt :NamedPlace .

