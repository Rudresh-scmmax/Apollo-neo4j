#################################################################
#  Classes -  Assertions (claims, not facts) - Begin
#################################################################

:Assertion rdf:type owl:Class ;
				  rdfs:subClassOf gist:Information ;
				  rdfs:label "Assertion"@en ;
				  rdfs:comment "A claim made by a source about an event, trend, expectation, or condition. Assertions may be uncertain, conflicting, or revised over time."@en .

#################################################################
#  Classes -  Assertions (claims, not facts) - End
#################################################################

#################################################################
#  Object properties -  Assertions (claims, not facts) - Begin
#################################################################



:assertedIn rdf:type owl:ObjectProperty ;
				  rdfs:domain :Assertion ;
				  rdfs:range :InformationObject ;
				  rdfs:label "asserted in"@en .


:assertedBy rdf:type owl:ObjectProperty ;
				  rdfs:domain :Assertion ;
				  rdfs:range gist:Organization ;
				  rdfs:label "asserted by"@en .


:isAbout rdf:type owl:ObjectProperty ;
				  rdfs:domain :Assertion ;
				  rdfs:range owl:Thing ;
				  rdfs:label "is about"@en ;
				  rdfs:comment "Indicates the entity, entities, or phenomena that the assertion is about, such as a material, supplier, factory, market, event, or region."@en .
	

:assertionConfidence rdf:type owl:ObjectProperty ;
				  rdfs:domain :Assertion ;
				  rdfs:range :ConfidenceLevel  ;
				  rdfs:label "assertion confidence"@en ;
				  rdfs:comment "Confidence level or reliability of the assertion."@en .



######    Assertion Valid from and Valid to dates are defined under :hasTemporalExtent right at the beginning

#################################################################
#  Object properties -  Assertions (claims, not facts) - End
#################################################################

#################################################################
#  Data properties -  Assertions (claims, not facts) - Begin
#################################################################

:assertionMadeAt rdf:type owl:DatatypeProperty ;
				  rdfs:domain :Assertion ;
				  rdfs:range xsd:dateTime ;
				  rdfs:label "assertion made at"@en ;
				  rdfs:comment "The date and time when the assertion was issued or published (e.g., report release date)."@en .


