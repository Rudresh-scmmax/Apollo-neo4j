#  Data properties -  Assertions (claims, not facts) - End
#################################################################



#################################################################
# Classes  - Events (real-world happenings) - Begin
#################################################################

:MarketEvent rdf:type owl:Class ;
				  rdfs:subClassOf gist:Event ;
				  rdfs:label "Market Event"@en ;
				  rdfs:comment "A real or planned event that affects supply, demand, price, or availability of a material or supplier."@en .

:CapacityAdditionEvent rdf:type owl:Class ;
				  rdfs:subClassOf :MarketEvent ;
				  rdfs:label "Capacity Addition Event"@en .

:SupplyDisruptionEvent rdf:type owl:Class ;
				  rdfs:subClassOf :MarketEvent ;
				  rdfs:label "Supply Disruption Event"@en ;
				  skos:prefLabel "Supply Disruption"@en ;
				  skos:altLabel "Plant Shutdown"@en ;
				  skos:altLabel "Plant Closure"@en ;
				  skos:altLabel "Breakdown"@en ;
				  skos:altLabel "Unplanned Outage"@en ;
				  skos:altLabel "Maintenance Shutdown"@en ;
				  rdfs:comment "An event that disrupts normal supply of a materxial due to shutdowns, breakdowns, maintenance, or other operational interruptions."@en .

:RegulatoryChangeEvent rdf:type owl:Class ;
				  rdfs:subClassOf :MarketEvent ;
				  rdfs:label "Regulatory Change Event"@en ;
				  skos:prefLabel "Regulatory Change Event"@en ;
				  skos:altLabel "Rule Changes"@en ;
				  skos:altLabel "Regulation Changes"@en ;
				  skos:altLabel "Regulatory Requirement Changes"@en .

:ForceMajeureEvent rdf:type owl:Class ;
				  rdfs:subClassOf :MarketEvent ;
				  rdfs:label "Force Majeure Event"@en ;
				  skos:prefLabel "Force Majeure Event"@en ;
				  skos:altLabel "earthquake"@en ;
				  skos:altLabel "flood"@en ;
				  skos:altLabel "port strike"@en ;
				  skos:altLabel "storm"@en ;
				  skos:hiddenLabel "force major"@en .
				  
#################################################################
# Classes  - Events (real-world happenings) - End
#################################################################


#################################################################
# Object Properties  - Events (real-world happenings) - Begin
#################################################################


:affectsMaterial rdf:type owl:ObjectProperty ;
				  rdfs:domain :MarketEvent ;
				 rdfs:range [ rdf:type owl:Class ;
                          owl:unionOf ( :RawMaterialofMaterialRequiredForProduction :MaterialRequiredForProduction ) ] ;
				  rdfs:label "affects material"@en .


:involvesOrganization rdf:type owl:ObjectProperty ;
				  rdfs:domain :MarketEvent ;
				  rdfs:range :Company ;
				  rdfs:label "involves company"@en .

:hasLocation rdf:type owl:ObjectProperty ;
				  rdfs:domain :MarketEvent ;
				  rdfs:range gist:GeoLocation ;
				  rdfs:label "has location"@en .


#################################################################
#   Classes  - Observations / Signals / Findings - Begin
#################################################################

:MarketSignal rdf:type owl:Class ;
				  rdfs:subClassOf gist:Event .

:SupplySignal rdf:type owl:Class ;
				  rdfs:subClassOf :MarketSignal ;
				  rdfs:label "Supply Signal"@en ;
				  rdfs:comment "An observed signal indicating changes or stress in supply conditions, such as tightness, surplus, or disruption risk."@en .

:DemandSignal rdf:type owl:Class ;
				  rdfs:subClassOf :MarketSignal ;
				  rdfs:label "Demand Signal"@en ;
				  rdfs:comment "An observed signal indicating changes in demand conditions, such as growth, slowdown, or substitution effects."@en .

:CapacitySignal rdf:type owl:Class ;
				  rdfs:subClassOf :MarketSignal ;
				  rdfs:label "Capacity Signal"@en ;
				  rdfs:comment "An observed signal related to production capacity utilization, additions, shutdowns, or constraints."@en .

#################################################################
#   Classes  - Observations / Signals / Trends - End
#################################################################


#################################################################
# Object Properties  - Observations / Signals / Trends  - Begin
#################################################################


:observedMaterial rdf:type owl:ObjectProperty ;
				  rdfs:domain :MarketSignal ;
				  rdfs:range gist:CatalogItem ;
				  rdfs:label "observed material"@en .

:observedMarket rdf:type owl:ObjectProperty ;
				  rdfs:domain :MarketSignal ;
				  rdfs:range gist:GeoLocation ;
				  rdfs:label "observed market"@en .

###    Magnitude for MarketSignal is  defined under :hasMagnitude right at the beginning

#################################################################
# Object Properties  - Observations / Signals / Trends  - End
#################################################################



#################################################################
# Classes  -  Market Drivers - Begin
#################################################################

:MarketDriver rdf:type owl:Class ;
				  rdfs:subClassOf gist:Category ;
				  rdfs:label "Market Driver"@en ;
				  rdfs:comment "An underlying factor that influences supply, demand, price, or risk, such as energy costs, feedstock availability, technology shifts, or regulation."@en .

#################################################################
# Market Driver   — instances / values - Begin (Core Set)
#################################################################

:DemandGrowth rdf:type :MarketDriver ;
    rdfs:label "Demand Growth"@en ;
    rdfs:comment "Market conditions where increasing downstream consumption is driving higher demand for a material."@en .

:DemandDecline rdf:type :MarketDriver ;
    rdfs:label "Demand Decline"@en ;
    rdfs:comment "Market conditions where weakening downstream consumption is reducing demand for a material."@en .

:SupplyConstraint rdf:type :MarketDriver ;
    rdfs:label "Supply Constraint"@en ;
    rdfs:comment "Conditions where limited production capacity, shutdowns, or disruptions restrict supply availability."@en .

:CapacityExpansion rdf:type :MarketDriver ;
    rdfs:label "Capacity Expansion"@en ;
    rdfs:comment "Addition of new production capacity that increases supply availability."@en .

:FeedstockCostChange rdf:type :MarketDriver ;
    rdfs:label "Feedstock Cost Change"@en ;
    rdfs:comment "Changes in upstream raw material or feedstock prices that impact production costs."@en .

:EnergyCostChange rdf:type :MarketDriver ;
    rdfs:label "Energy Cost Change"@en ;
    rdfs:comment "Changes in energy prices affecting manufacturing or logistics costs."@en .

:RegulatoryChange rdf:type :MarketDriver ;
    rdfs:label "Regulatory Change"@en ;
    rdfs:comment "New or changing regulations impacting production, trade, or compliance costs."@en .

:GeopoliticalRisk rdf:type :MarketDriver ;
    rdfs:label "Geopolitical Risk"@en ;
    rdfs:comment "Political or geopolitical developments that impact supply chains, trade flows, or risk exposure."@en .

:LogisticsDisruption rdf:type :MarketDriver ;
    rdfs:label "Logistics Disruption"@en ;
    rdfs:comment "Disruptions in transportation or logistics networks affecting material availability or cost."@en .


#################################################################
# Market Driver   — instances / values - End (Core Set)
#################################################################


#################################################################
# Classes  -  Market Drivers - End
#################################################################

#################################################################
# Object Properties  -  Market Drivers - Begin
#################################################################

:drivenBy rdf:type owl:ObjectProperty ;
				  rdfs:domain gist:Assertion ;
				  rdfs:range :MarketDriver ;
				  rdfs:label "driven by market driver"@en ;
				  rdfs:comment "Links an assertion or observation to the underlying market driver that explains the observed or expected condition."@en .

:drivesEvent rdf:type owl:ObjectProperty ;
				  rdfs:domain :MarketDriver ;
				  rdfs:range :MarketEvent ;
				  rdfs:label "drives event"@en .

:drivesSignal rdf:type owl:ObjectProperty ;
				  rdfs:domain :MarketDriver ;
				  rdfs:range :MarketSignal ;
				  rdfs:label "drives trend"@en .

#################################################################
# Object Properties  -  Market Drivers - End
#################################################################

#################################################################
# Classes - Assessments (derived interpretations) - Begin
#################################################################

:Assessment rdf:type owl:Class ;
    rdfs:subClassOf gist:Information ;
    rdfs:label "Assessment"@en ;
    rdfs:comment "An evaluative interpretation derived from events, observations, and assertions, such as risk level, outlook, or impact analysis."@en .

:RiskAssessment rdf:type owl:Class ;
    rdfs:subClassOf :Assessment ;
    rdfs:label "Risk Assessment"@en .


:AssessmentOutcome rdf:type owl:Class ;
    rdfs:subClassOf gist:Category ;
    rdfs:label "Assessment Outcome"@en ;
    rdfs:comment "A controlled category representing the conclusion or decision resulting from an assessment, such as approve, reject, or shortlist."@en .

#################################################################
# AssessmentOutcome  — instances / values - Begin
#################################################################


:Approved rdf:type :AssessmentOutcome ;
    rdfs:label "Approved"@en ;
    rdfs:comment "Indicates that the assessed option meets requirements and is approved for use or selection."@en .

:Rejected rdf:type :AssessmentOutcome ;
    rdfs:label "Rejected"@en ;
    rdfs:comment "Indicates that the assessed option does not meet requirements and is rejected."@en .

:Shortlisted rdf:type :AssessmentOutcome ;
    rdfs:label "Shortlisted"@en ;
    rdfs:comment "Indicates that the assessed option is acceptable and retained for further evaluation or negotiation."@en .

#################################################################
# AssessmentOutcome  — instances / values - End
#################################################################


#################################################################
# Classes - Assessments (derived interpretations) - End
#################################################################

#################################################################
# Object Properties - Assessments (derived interpretations) - End
#################################################################
:assessesMaterial rdf:type owl:ObjectProperty ;
				  rdfs:domain :Assessment ;
				  rdfs:range gist:CatalogItem ;
				  rdfs:label "assesses material"@en .

:assessesCompany rdf:type owl:ObjectProperty ;
				  rdfs:domain :Assessment ;
				  rdfs:range :Company ;
				  rdfs:label "assesses supplier"@en .


:basedOnEvent rdf:type owl:ObjectProperty ;
				  rdfs:domain :Assessment ;
				  rdfs:range :MarketEvent ;
				  rdfs:label "based on event"@en .

:basedOnSignal rdf:type owl:ObjectProperty ;
				  rdfs:domain :Assessment ;
				  rdfs:range :MarketSignal ;
				  rdfs:label "based on trend"@en .


:assessmentConfidence rdf:type owl:ObjectProperty ;
				  rdfs:domain :Assessment ;
				  rdfs:range :ConfidenceLevel ;
				  rdfs:label "has confidence level"@en ;
				  rdfs:comment "Indicates the qualitative confidence assigned to an assessment result."@en .

:hasAssessmentOutcome rdf:type owl:ObjectProperty ;
				  rdfs:domain gist:Assessment ;
				  rdfs:range :AssessmentOutcome ;
				  rdfs:label "has assessment outcome"@en ;
				  rdfs:comment "Indicates the final decision or conclusion reached by an assessment."@en .



#################################################################
# Data properties - Assessments (derived interpretations) - Begin
#################################################################


:assessmentMadeAt rdf:type owl:DatatypeProperty ;
				  rdfs:domain :Assessment ;
				  rdfs:range xsd:dateTime ;
				  rdfs:label "Assessment made at"@en ;
				  rdfs:comment "The date and time when the assertion was issued or published (e.g., report release date)."@en .

#################################################################
# Data properties - Assessments (derived interpretations) - End
#################################################################


#################################################################
# Classes - Meeting - Begin
#################################################################

:Meeting rdf:type owl:Class ;
    rdfs:subClassOf gist:Event ;
    rdfs:label "Meeting"@en ;
    rdfs:comment "A formal or informal interaction between two or more parties where topics are discussed, decisions are made, and commitments or action items may be agreed."@en .


#################################################################
# Classes - Meeting - End
#################################################################



#################################################################
# Object Properties - Meeting - Begin
#################################################################

:involvesOrganization rdf:type owl:ObjectProperty ;
    rdfs:domain :Meeting ;
    rdfs:range gist:Organization ;
    rdfs:label "involves organization"@en ;
    rdfs:comment "Indicates an organization that participated in the meeting."@en .

:relatedToProject rdf:type owl:ObjectProperty ;
    rdfs:domain :Meeting ;
    rdfs:range :Project ;
    rdfs:label "related to project"@en ;
    rdfs:comment "Links a meeting to the project or initiative discussed."@en .

:relatedToMaterial rdf:type owl:ObjectProperty ;
    rdfs:domain :Meeting ;
    rdfs:range :MaterialRequiredForProduction ;
    rdfs:label "related to project"@en ;
    rdfs:comment "Links a meeting to the material discussed."@en .



#################################################################
# Object Properties - Meeting - End
#################################################################



#################################################################
# Classes - Project - Begin
#################################################################

:Project rdf:type owl:Class ;
				  rdfs:subClassOf gist:Plan ;
				  rdfs:label "Project"@en ;
				  rdfs:comment "A structured initiative or program with defined objectives, scope, and expected outcomes, often spanning multiple meetings and actions."@en .

:ProcessImprovementProject rdf:type owl:Class ;
				  rdfs:subClassOf :Project ;
				  rdfs:label "Process Improvement Project"@en ;
				  rdfs:comment "A collaborative project between customer and supplier aimed at improving productivity, quality, consistency, or cost at a manufacturing facility."@en .



#################################################################
# Classes - Project - End
#################################################################


#################################################################
# Object Property - Project - Begin
#################################################################

:forSupplier rdf:type owl:ObjectProperty ;
				  rdfs:domain :Project ;
				  rdfs:range :Company ;
				  rdfs:label "for supplier"@en ;
				  rdfs:comment "Indicates the supplier organization involved in the project."@en .

:atSupplierManufacturingPlant rdf:type owl:ObjectProperty ;
				  rdfs:domain :Project ;
				  rdfs:range :SupplierManufacturingPlant ;
				  rdfs:label "at plant"@en ;
				  rdfs:comment "Indicates the supplier manufacturing plant where the project is executed."@en .

:relatedMaterial rdf:type owl:ObjectProperty ;
				  rdfs:domain :Project ;
				  rdfs:range :MaterialRequiredForProduction ;
				  rdfs:label "related material"@en ;
				  rdfs:comment "Links a project to the material(s) impacted by it."@en .

#################################################################
# Object Property - Project - End
#################################################################

#################################################################
# Classes - Action Item - Begin
#################################################################

:ActionItem rdf:type owl:Class ;
    rdfs:subClassOf gist:Commitment ;
    rdfs:label "Action Item"@en ;
    rdfs:comment "A specific task or obligation agreed during a meeting, with an owner, due date, and expected outcome."@en .

#################################################################
# Classes - Action Item - End
#################################################################


#################################################################
# Object Properties - Action Item - Begin
#################################################################

:originatedFromMeeting rdf:type owl:ObjectProperty ;
				  rdfs:domain :ActionItem ;
				  rdfs:range :Meeting ;
				  rdfs:label "originated from meeting"@en ;
				  rdfs:comment "Indicates the meeting during which the action item was agreed."@en .

:assignedTo rdf:type owl:ObjectProperty ;
				  rdfs:domain :ActionItem ;
				  rdfs:range gist:Organization ;
				  rdfs:label "assigned to"@en ;
				  rdfs:comment "Indicates the organization responsible for completing the action item."@en .

:relatedToProject rdf:type owl:ObjectProperty ;
				  rdfs:domain :ActionItem ;
				  rdfs:range :Project ;
				  rdfs:label "related to project"@en ;
				  rdfs:comment "Links an action item to the project it supports."@en .

:relatedMaterial rdf:type owl:ObjectProperty ;
				  rdfs:domain :ActionItem ;
				  rdfs:range :MaterialRequiredForProduction ;
				  rdfs:label "related material"@en ;
				  rdfs:comment "Links an action item to the material it impacts, if applicable."@en .

#################################################################
# Object Properties - Action Item - Begin
#################################################################

#################################################################
#Data Properties - # Action Item  - Begin
#################################################################


:hasStatus rdf:type owl:DatatypeProperty ;
    rdfs:domain :ActionItem ;
    rdfs:range :ActionItemStatus ;
    rdfs:label "has status"@en ;
    rdfs:comment "The current status of the action item (Open, In Progress, Completed, Delayed)."@en .

:dueBy rdf:type owl:DatatypeProperty ;
    rdfs:domain :ActionItem ;
    rdfs:range xsd:date ;
    rdfs:label "due by date"@en ;
    rdfs:comment "The target completion date for the action item."@en .

#################################################################
#Data Properties - # Action Item  - End
#################################################################



#################################################################
#Classes - # Action Item Status - Begin
#################################################################

:ActionItemStatus rdf:type owl:Class ;
    rdfs:subClassOf gist:Category ;
    rdfs:label "Action Item Status"@en .

#################################################################
#Classes - # Action Item Status - End
#################################################################

#################################################################
# ActionItemStatus Instances / values - Begin
#################################################################


:Open rdf:type :ActionItemStatus ;
    rdfs:label "Open"@en .

:InProgress rdf:type :ActionItemStatus ;
    rdfs:label "In Progress"@en .

:Completed rdf:type :ActionItemStatus ;
    rdfs:label "Completed"@en .

:Delayed rdf:type :ActionItemStatus ;
    rdfs:label "Delayed"@en .
