###  http://www.apollo-procurement.org/ontology#SupplyAgreement
:SupplyAgreement rdf:type owl:Class ;
                 rdfs:subClassOf gist:Agreement ;
                 rdfs:label "Supply Agreement"@en .




#################################################################
#    Classes (Supply Agreement - End)
#################################################################

#################################################################
#    Object Properties  (Supply Agreement - Begin)
#################################################################

###  http://www.apollo-procurement.org/ontology#hasSupplierParty
:hasSupplierParty rdf:type owl:ObjectProperty ;
                  rdfs:domain :SupplyAgreement ;
                  rdfs:range :Company ;
                  rdfs:label "has Supplier Party"@en .

###  http://www.apollo-procurement.org/ontology#coversMaterial
:coversMaterial rdf:type owl:ObjectProperty ;
                rdfs:domain :SupplyAgreement ;
                rdfs:range :MaterialRequiredForProduction ;
                rdfs:label "covers Material"@en .

###  http://www.apollo-procurement.org/ontology#hasCustomerParty
:hasCustomerParty rdf:type owl:ObjectProperty ;
                  rdfs:domain :SupplyAgreement ;
                  rdfs:range :Company ;
                  rdfs:label "has Customer Party"@en .


:applicableToOwnManufacturingPlant rdf:type owl:ObjectProperty ;
    rdfs:domain :SupplyAgreement ;
    rdfs:range :OwnManufacturingPlant ;
    rdfs:label "applicable to plant"@en ;
    rdfs:comment "Indicates the manufacturing plant(s) that are intended to receive material under this supply agreement."@en .


:isSourcedFromSupplierManufacturingPlant rdf:type owl:ObjectProperty ;
    rdfs:domain :SupplyAgreement ;
    rdfs:range :SupplierManufacturingPlant ;
    rdfs:label "sourced from supplier plant"@en ;
    rdfs:comment "Indicates the supplier manufacturing plant(s) that are intended to ship the material under this supply agreement."@en .


:hasContractedPrice rdf:type owl:ObjectProperty ;
    rdfs:domain :SupplyAgreement ;
    rdfs:range :ContractedPrice ;
    rdfs:label "has contracted price"@en ;
    rdfs:comment "Links a supply agreement to the price contractually agreed for the material supplied under the agreement."@en .

###ContractedPrice is defined under PriceObservation class


:basedOnApproval rdf:type owl:ObjectProperty ;
    rdfs:domain :SupplyAgreement ;
    rdfs:range :ApprovedSupplierAuthorization ;
    rdfs:label "based on approval"@en ;
    rdfs:comment "Indicates the approved supplier authorization under which this supply agreement is entered into."@en .



###    Supply Agreement Valid from and Valid to dates are defined under :hasTemporalExtent right at the beginning


