          rdfs:label "Incoterm (Incoterms® 2020)"@en .


###  http://www.apollo-procurement.org/ontology#InformationObject
:InformationObject rdf:type owl:Class ;
                   rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Information> ;
                   rdfs:comment "An informational artifact such as a market report, supplier email, meeting minutes, or subscription feed that contains claims about the domain."@en ;
                   rdfs:label "Information Object"@en .


###  http://www.apollo-procurement.org/ontology#InventorySnapshot
:InventorySnapshot rdf:type owl:Class ;
                   rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Event> ;
                   rdfs:comment "A point-in-time observation of inventory quantity and type for a specific material at a specific plant. Inventory snapshots represent state, not individual stock movements, and are intended for decision-making and reasoning rather than transactional accounting."@en ;
                   rdfs:label "Inventory Snapshot"@en .


###  http://www.apollo-procurement.org/ontology#InventoryType
:InventoryType rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Category> ;
               rdfs:comment "A categorical classification of inventory based on its status, such as available, obselete, on-hold, quality check pending."@en ;
               rdfs:label "Inventory Type"@en .


###  http://www.apollo-procurement.org/ontology#LogisticsLeg
:LogisticsLeg rdf:type owl:Class ;
              rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Plan> ;
              rdfs:comment "A planned segment of a logistics route between two locations using a single shipment mode."@en ;
              rdfs:label "Logistics Leg"@en .


###  http://www.apollo-procurement.org/ontology#LogisticsRoute
:LogisticsRoute rdf:type owl:Class ;
                rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Plan> .


###  http://www.apollo-procurement.org/ontology#MarketDriver
:MarketDriver rdf:type owl:Class ;
              rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Category> ;
              rdfs:comment "An underlying factor that influences supply, demand, price, or risk, such as energy costs, feedstock availability, technology shifts, or regulation."@en ;
              rdfs:label "Market Driver"@en .


###  http://www.apollo-procurement.org/ontology#MarketEvent
:MarketEvent rdf:type owl:Class ;
             rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Event> ;
             rdfs:comment "A real or planned event that affects supply, demand, price, or availability of a material or supplier."@en ;
             rdfs:label "Market Event"@en .


###  http://www.apollo-procurement.org/ontology#MarketResearchReport
:MarketResearchReport rdf:type owl:Class ;
                      rdfs:subClassOf :InformationObject ;
                      rdfs:label "Market Research Report"@en .


###  http://www.apollo-procurement.org/ontology#MarketSignal
:MarketSignal rdf:type owl:Class ;
              rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Event> .


###  http://www.apollo-procurement.org/ontology#MaterialGroupbyChemistry
:MaterialGroupbyChemistry rdf:type owl:Class ;
                          rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Category> ;
                          rdfs:comment "A controlled category grouping materials based on their chemical structure or functional group, used for substitution analysis, risk assessment, and market intelligence."@en ;
                          rdfs:label "Material Group by Chemistry"@en .


###  http://www.apollo-procurement.org/ontology#MaterialGroupbyEndUse
:MaterialGroupbyEndUse rdf:type owl:Class ;
                       rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Category> ;
                       rdfs:comment "A controlled category grouping materials based on their industrial or functional application, independent of chemical structure. (e.g., Solvent, Adhesive)."@en ;
                       rdfs:label "Material Group by End Use"@en .


###  http://www.apollo-procurement.org/ontology#MaterialRequiredForProduction
:MaterialRequiredForProduction rdf:type owl:Class ;
