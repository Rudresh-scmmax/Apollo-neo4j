@prefix : <http://api.stardog.com/> .
@prefix so: <https://schema.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix stardog: <tag:stardog:api:> .
@base <http://api.stardog.com/> .

<http://www.apollo-procurement.org/ontology> rdf:type owl:Ontology ;
                                              owl:imports <https://w3id.org/semanticarts/ontology/gistCore> ;
                                              rdfs:comment "The Apollo Procurement Ontology. Complete version supporting Price Forecasting, Drivers, Substitution, Risk, and BOM."@en ;
                                              rdfs:label "Apollo Procurement Ontology"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://www.apollo-procurement.org/ontology#ownedBy
:ownedBy rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#hiddenLabel
<http://www.w3.org/2004/02/skos/core#hiddenLabel> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.apollo-procurement.org/ontology#affectsMaterial
:affectsMaterial rdf:type owl:ObjectProperty ;
                 rdfs:domain :MarketEvent ;
                 rdfs:range [ rdf:type owl:Class ;
                              owl:unionOf ( :MaterialRequiredForProduction
                                            :RawMaterialofMaterialRequiredForProduction
                                          )
                            ] ;
                 rdfs:label "affects material"@en .


###  http://www.apollo-procurement.org/ontology#applicableFactory
:applicableFactory rdf:type owl:ObjectProperty ;
                   rdfs:domain :QualitySpecification ;
                   rdfs:range :OwnManufacturingPlant ;
                   rdfs:comment "Indicates the manufacturing plant or factory where this quality specification applies. Allows factory-specific acceptance criteria."@en ;
                   rdfs:label "applicable factory"@en .


###  http://www.apollo-procurement.org/ontology#applicableLocation
:applicableLocation rdf:type owl:ObjectProperty ;
                    rdfs:domain :BenchmarkPrice ;
                    rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/GeoLocation> ;
                    rdfs:comment "The region, country, or plant where this price is valid."@en ;
                    rdfs:label "has Location of Price Obervation"@en .


###  http://www.apollo-procurement.org/ontology#applicablePlant
:applicablePlant rdf:type owl:ObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :ContractedPrice
                                             :Quotation
                                           )
                             ] ;
                 rdfs:range :OwnManufacturingPlant ;
                 rdfs:comment "The plant / factory mentioned on the PO or Invoice of the Transaction. "@en ;
                 rdfs:label "The plant this price is valid for"@en .


###  http://www.apollo-procurement.org/ontology#applicableToOwnManufacturingPlant
:applicableToOwnManufacturingPlant rdf:type owl:ObjectProperty ;
                                   rdfs:domain :SupplyAgreement ;
                                   rdfs:range :OwnManufacturingPlant ;
                                   rdfs:comment "Indicates the manufacturing plant(s) that are intended to receive material under this supply agreement."@en ;
                                   rdfs:label "applicable to plant"@en .


###  http://www.apollo-procurement.org/ontology#appliesToMaterial
:appliesToMaterial rdf:type owl:ObjectProperty ;
                   rdfs:domain :QualitySpecification ;
                   rdfs:range :MaterialRequiredForProduction ;
                   rdfs:comment "Indicates the material or supplier product to which this quality specification applies."@en ;
                   rdfs:label "applies to material or product"@en .


###  http://www.apollo-procurement.org/ontology#approvedForPlant
:approvedForPlant rdf:type owl:ObjectProperty ;
                  rdfs:domain :ApprovedSupplierAuthorization ;
                  rdfs:range :OwnManufacturingPlant ;
                  rdfs:comment "The manufacturing plant for which the approval is valid."@en ;
                  rdfs:label "approved for plant"@en .


###  http://www.apollo-procurement.org/ontology#approvedMaterial
:approvedMaterial rdf:type owl:ObjectProperty ;
                  rdfs:domain :ApprovedSupplierAuthorization ;
                  rdfs:range :MaterialRequiredForProduction ;
                  rdfs:comment "The material the supplier is approved to supply."@en ;
                  rdfs:label "approved material"@en .


###  http://www.apollo-procurement.org/ontology#approvedSupplier
:approvedSupplier rdf:type owl:ObjectProperty ;
                  rdfs:domain :ApprovedSupplierAuthorization ;
                  rdfs:range :Company ;
                  rdfs:comment "The supplier organization that has been approved."@en ;
                  rdfs:label "approved supplier"@en .


###  http://www.apollo-procurement.org/ontology#assertedBy
:assertedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :Assertion ;
            rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/Organization> ;
            rdfs:label "asserted by"@en .


###  http://www.apollo-procurement.org/ontology#assertedIn
:assertedIn rdf:type owl:ObjectProperty ;
            rdfs:domain :Assertion ;
            rdfs:range :InformationObject ;
            rdfs:label "asserted in"@en .


###  http://www.apollo-procurement.org/ontology#assertionConfidence
:assertionConfidence rdf:type owl:ObjectProperty ;
                     rdfs:domain :Assertion ;
                     rdfs:range :ConfidenceLevel ;
                     rdfs:comment "Confidence level or reliability of the assertion."@en ;
                     rdfs:label "assertion confidence"@en .


###  http://www.apollo-procurement.org/ontology#assessesCompany
:assessesCompany rdf:type owl:ObjectProperty ;
                 rdfs:domain :Assessment ;
                 rdfs:range :Company ;
                 rdfs:label "assesses supplier"@en .


###  http://www.apollo-procurement.org/ontology#assessesMaterial
:assessesMaterial rdf:type owl:ObjectProperty ;
                  rdfs:domain :Assessment ;
                  rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/CatalogItem> ;
                  rdfs:label "assesses material"@en .


###  http://www.apollo-procurement.org/ontology#assessesQuotation
:assessesQuotation rdf:type owl:ObjectProperty ;
                   rdfs:domain :QuotationComparisonAssessment ;
                   rdfs:range :Quotation ;
                   rdfs:label "assesses quotation"@en .


###  http://www.apollo-procurement.org/ontology#assessmentConfidence
:assessmentConfidence rdf:type owl:ObjectProperty ;
                      rdfs:domain :Assessment ;
                      rdfs:range :ConfidenceLevel ;
                      rdfs:comment "Indicates the qualitative confidence assigned to an assessment result."@en ;
                      rdfs:label "has confidence level"@en .


###  http://www.apollo-procurement.org/ontology#assignedTo
:assignedTo rdf:type owl:ObjectProperty ;
            rdfs:domain :ActionItem ;
            rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/Organization> ;
            rdfs:comment "Indicates the organization responsible for completing the action item."@en ;
            rdfs:label "assigned to"@en .


###  http://www.apollo-procurement.org/ontology#atPlant
:atPlant rdf:type owl:ObjectProperty ;
         rdfs:domain :InventorySnapshot ;
         rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/Organization> ;
         rdfs:comment "Indicates the manufacturing plant or warehouse where the inventory is physically located."@en ;
         rdfs:label "at plant"@en .


###  http://www.apollo-procurement.org/ontology#atSupplierManufacturingPlant
:atSupplierManufacturingPlant rdf:type owl:ObjectProperty ;
                              rdfs:domain :Project ;
                              rdfs:range :SupplierManufacturingPlant ;
                              rdfs:comment "Indicates the supplier manufacturing plant where the project is executed."@en ;
                              rdfs:label "at plant"@en .


###  http://www.apollo-procurement.org/ontology#basedOnApproval
:basedOnApproval rdf:type owl:ObjectProperty ;
                 rdfs:domain :SupplyAgreement ;
                 rdfs:range :ApprovedSupplierAuthorization ;
                 rdfs:comment "Indicates the approved supplier authorization under which this supply agreement is entered into."@en ;
                 rdfs:label "based on approval"@en .


###  http://www.apollo-procurement.org/ontology#basedOnEvent
:basedOnEvent rdf:type owl:ObjectProperty ;
              rdfs:domain :Assessment ;
              rdfs:range :MarketEvent ;
              rdfs:label "based on event"@en .


###  http://www.apollo-procurement.org/ontology#basedOnSignal
:basedOnSignal rdf:type owl:ObjectProperty ;
               rdfs:domain :Assessment ;
               rdfs:range :MarketSignal ;
               rdfs:label "based on trend"@en .


###  http://www.apollo-procurement.org/ontology#belongsToChemistryGroup
:belongsToChemistryGroup rdf:type owl:ObjectProperty ;
                         rdfs:domain :MaterialRequiredForProduction ;
                         rdfs:range :MaterialGroupbyChemistry ;
                         rdfs:label "belongs To Chemistry Group"@en .


###  http://www.apollo-procurement.org/ontology#belongsToEndUseGroup
:belongsToEndUseGroup rdf:type owl:ObjectProperty ;
                      rdfs:domain :MaterialRequiredForProduction ;
                      rdfs:range :MaterialGroupbyEndUse ;
                      rdfs:comment "Indicates the primary industrial or functional application of the material."@en ;
                      rdfs:label "belongs To End use Group"@en ,
                                 "belongs to end use group"@en .


###  http://www.apollo-procurement.org/ontology#buyerBearsCost
:buyerBearsCost rdf:type owl:ObjectProperty ;
                rdfs:domain :Incoterm ;
                rdfs:range :CostComponent ;
                rdfs:comment "Indicates a cost component that is the responsibility of the buyer under this Incoterm® 2020."@en ;
                rdfs:label "buyer bears cost"@en .


###  http://www.apollo-procurement.org/ontology#coversMaterial
:coversMaterial rdf:type owl:ObjectProperty ;
                rdfs:domain :SupplyAgreement ;
                rdfs:range :MaterialRequiredForProduction ;
                rdfs:label "covers Material"@en .


###  http://www.apollo-procurement.org/ontology#deliveryDestination
:deliveryDestination rdf:type owl:ObjectProperty ;
                     rdfs:domain :Quotation ;
                     rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/GeoLocation> ;
                     rdfs:comment "Destination up to which the supplier is responsible under the quotation (plant, port, or other location)."@en ;
                     rdfs:label "delivery destination"@en .


###  http://www.apollo-procurement.org/ontology#drivenBy
:drivenBy rdf:type owl:ObjectProperty ;
          rdfs:domain <https://w3id.org/semanticarts/ns/ontology/gist/Assertion> ;
          rdfs:range :MarketDriver ;
          rdfs:comment "Links an assertion or observation to the underlying market driver that explains the observed or expected condition."@en ;
          rdfs:label "driven by market driver"@en .


###  http://www.apollo-procurement.org/ontology#drivesEvent
:drivesEvent rdf:type owl:ObjectProperty ;
             rdfs:domain :MarketDriver ;
             rdfs:range :MarketEvent ;
             rdfs:label "drives event"@en .


###  http://www.apollo-procurement.org/ontology#drivesSignal
:drivesSignal rdf:type owl:ObjectProperty ;
              rdfs:domain :MarketDriver ;
              rdfs:range :MarketSignal ;
              rdfs:label "drives trend"@en .


###  http://www.apollo-procurement.org/ontology#entityRole
:entityRole rdf:type owl:ObjectProperty ;
            rdfs:domain :ContextualEntityOccurrence ;
            rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/Category> ;
            rdfs:comment "Indicates the semantic role an entity plays in the given context, such as supplier, material, plant, location, or event."@en ;
            rdfs:label "entity role in context"@en .


###  http://www.apollo-procurement.org/ontology#forAspect
:forAspect rdf:type owl:ObjectProperty ;
           rdfs:domain :QCMeasurement ;
           rdfs:range :QualityAspect ;
           rdfs:comment "Indicates which quality aspect a QC measurement is about (purity, water content, etc.)." ;
           rdfs:label "for aspect" .


###  http://www.apollo-procurement.org/ontology#forCostComponent
:forCostComponent rdf:type owl:ObjectProperty ;
                  rdfs:domain :CostRuleTemplate ;
                  rdfs:range :CostComponent ;
                  rdfs:label "for cost component"@en .


###  http://www.apollo-procurement.org/ontology#forMaterial
:forMaterial rdf:type owl:ObjectProperty ;
             rdfs:domain :InventorySnapshot ;
             rdfs:range :MaterialRequiredForProduction ;
             rdfs:comment "Indicates the material for which the inventory snapshot is recorded."@en ;
             rdfs:label "for material"@en .


###  http://www.apollo-procurement.org/ontology#forSupplier
:forSupplier rdf:type owl:ObjectProperty ;
             rdfs:domain :Project ;
             rdfs:range :Company ;
             rdfs:comment "Indicates the supplier organization involved in the project."@en ;
             rdfs:label "for supplier"@en .


###  http://www.apollo-procurement.org/ontology#forecastedForMaterial
:forecastedForMaterial rdf:type owl:ObjectProperty ;
                       rdfs:domain :ForecastedPrice ;
                       rdfs:range :MaterialRequiredForProduction ;
                       rdfs:label "MaterialRequiredForProduction forecasted for. "@en .


###  http://www.apollo-procurement.org/ontology#forecastedForRegion
:forecastedForRegion rdf:type owl:ObjectProperty ;
                     rdfs:domain :ForecastedPrice ;
                     rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/GeoLocation> ;
                     rdfs:label "observed market"@en .


###  http://www.apollo-procurement.org/ontology#hasAssessmentOutcome
:hasAssessmentOutcome rdf:type owl:ObjectProperty ;
                      rdfs:domain <https://w3id.org/semanticarts/ns/ontology/gist/Assessment> ;
                      rdfs:range :AssessmentOutcome ;
                      rdfs:comment "Indicates the final decision or conclusion reached by an assessment."@en ;
                      rdfs:label "has assessment outcome"@en .


###  http://www.apollo-procurement.org/ontology#hasBillOfMaterials
:hasBillOfMaterials rdf:type owl:ObjectProperty ;
                    rdfs:domain :MaterialRequiredForProduction ;
                    rdfs:range :BillOfMaterials ;
                    rdfs:comment "Associates a finished good with a specific bill of materials definition that describes how the item is manufactured. The Bill of Materials groups one or more BillOfMaterialsLine individuals and does not itself specify component quantities."@en ;
                    rdfs:label "has Bill of Materials"@en .


###  http://www.apollo-procurement.org/ontology#hasBillOfMaterialsLine
:hasBillOfMaterialsLine rdf:type owl:ObjectProperty ;
                        rdfs:domain :BillOfMaterials ;
                        rdfs:range :BillOfMaterialsLine ;
                        rdfs:comment "Links a Bill of Materials to its constituent BillOfMaterialsLine individuals. Each BillOfMaterialsLine represents one RawMaterialofMaterialRequiredForProduction entry, specifying an input material and the quantity required to produce the associated MaterialRequiredForProduction."@en ;
                        rdfs:label "has Bill of Materials Line" .


###  http://www.apollo-procurement.org/ontology#hasCASNumber
:hasCASNumber rdf:type owl:ObjectProperty ;
              rdfs:domain :MaterialRequiredForProduction ;
              rdfs:range :CASNumber ;
              rdfs:label "has a CAS Number"@en .


###  http://www.apollo-procurement.org/ontology#hasComparisonOperator
:hasComparisonOperator rdf:type owl:ObjectProperty ;
                       rdfs:domain :QualitySpecification ;
                       rdfs:range :ComparisonOperator ;
                       rdfs:comment "Indicates how the measured value should be compared to the threshold, such as greater than or equal to, between, equal to, or approximately equal to."@en ;
                       rdfs:label "has comparison operator"@en .


###  http://www.apollo-procurement.org/ontology#hasContractedPrice
:hasContractedPrice rdf:type owl:ObjectProperty ;
                    rdfs:domain :SupplyAgreement ;
                    rdfs:range :ContractedPrice ;
                    rdfs:comment "Links a supply agreement to the price contractually agreed for the material supplied under the agreement."@en ;
                    rdfs:label "has contracted price"@en .


###  http://www.apollo-procurement.org/ontology#hasCostComponentsApplicableToAQuotation
:hasCostComponentsApplicableToAQuotation rdf:type owl:ObjectProperty ;
                                         rdfs:domain :Quotation ;
                                         rdfs:range :CostComponentsApplicableToAQuotation ;
                                         rdfs:label "quotation has applicable cost components"@en .


###  http://www.apollo-procurement.org/ontology#hasCostEstimateForEachCostRuleTemplateApplicableToAQuotation
:hasCostEstimateForEachCostRuleTemplateApplicableToAQuotation rdf:type owl:ObjectProperty ;
                                                              rdfs:domain :CostEstimateForEachCostRuleTemplateApplicableToAQuotation ;
                                                              rdfs:range :CostRuleTemplatesApplicableToAQuotation ;
                                                              rdfs:label "cost estimate for each cost rule that is applicable to the cost components that are applicable to a quotation "@en .


###  http://www.apollo-procurement.org/ontology#hasCostRuleTemplatesApplicableToAQuotation
:hasCostRuleTemplatesApplicableToAQuotation rdf:type owl:ObjectProperty ;
                                            rdfs:domain :Quotation ;
                                            rdfs:range :CostRuleTemplatesApplicableToAQuotation ;
                                            rdfs:label "cost rules applicable to cost components that are applicable to a quotation "@en .


###  http://www.apollo-procurement.org/ontology#hasCurrency
:hasCurrency rdf:type owl:ObjectProperty ;
             rdfs:domain :PriceObservation ;
             rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/Currency> ;
             rdfs:label "has Currency of Price Observation"@en .


###  http://www.apollo-procurement.org/ontology#hasCustomerParty
:hasCustomerParty rdf:type owl:ObjectProperty ;
                  rdfs:domain :SupplyAgreement ;
                  rdfs:range :Company ;
                  rdfs:label "has Customer Party"@en .


###  http://www.apollo-procurement.org/ontology#hasDUNSNumber
:hasDUNSNumber rdf:type owl:ObjectProperty ;
               rdfs:domain :Company ;
               rdfs:range :DUNSNumber ;
               rdfs:label "Company has DUNS Number"@en .


###  http://www.apollo-procurement.org/ontology#hasDistance
:hasDistance rdf:type owl:ObjectProperty ;
             rdfs:domain :LogisticsLeg ;
             rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/Magnitude> ;
             rdfs:label "has distance"@en .


###  http://www.apollo-procurement.org/ontology#hasERPMaterialID
:hasERPMaterialID rdf:type owl:ObjectProperty ;
                  rdfs:domain :MaterialRequiredForProduction ;
                  rdfs:range :ERPMaterialRequiredForProductionID ;
                  rdfs:label "has a Material ID from Material Master in ERP"@en .


###  http://www.apollo-procurement.org/ontology#hasHSNCode
:hasHSNCode rdf:type owl:ObjectProperty ;
            rdfs:domain :MaterialRequiredForProduction ;
            rdfs:range :HSNCode ;
            rdfs:label "has a HSN Code"@en .


###  http://www.apollo-procurement.org/ontology#hasIncoterm
:hasIncoterm rdf:type owl:ObjectProperty ;
             rdfs:domain :Quotation ;
             rdfs:range :Incoterm ;
             rdfs:label "has incoterm"@en .


###  http://www.apollo-procurement.org/ontology#hasInventoryType
:hasInventoryType rdf:type owl:ObjectProperty ;
                  rdfs:domain :InventorySnapshot ;
                  rdfs:range :InventoryType ;
                  rdfs:comment "Specifies the type or status of the inventory (e.g., available, obselete, on-hold)."@en ;
                  rdfs:label "has inventory type"@en .


###  http://www.apollo-procurement.org/ontology#hasLeg
:hasLeg rdf:type owl:ObjectProperty ;
        rdfs:domain :LogisticsRoute ;
        rdfs:range :LogisticsLeg ;
        rdfs:label "has logistics leg"@en .


###  http://www.apollo-procurement.org/ontology#hasLocation
:hasLocation rdf:type owl:ObjectProperty ;
             rdfs:domain :MarketEvent ;
             rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/GeoLocation> ;
             rdfs:label "has location"@en .


###  http://www.apollo-procurement.org/ontology#hasLogisticsRoute
:hasLogisticsRoute rdf:type owl:ObjectProperty ;
                   rdfs:domain :Quotation ;
                   rdfs:range :LogisticsRoute ;
                   rdfs:label "has logistics route"@en .


###  http://www.apollo-procurement.org/ontology#hasLowerBoundMagnitude
:hasLowerBoundMagnitude rdf:type owl:ObjectProperty ;
                        rdfs:domain :QualitySpecification ;
                        rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/Magnitude> ;
                        rdfs:comment "Specifies the lower bound of an acceptable numeric range for a quality aspect."@en ;
                        rdfs:label "has lower bound magnitude"@en .


###  http://www.apollo-procurement.org/ontology#hasMagnitude
:hasMagnitude rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf <https://w3id.org/semanticarts/ns/ontology/gist/hasMagnitude> ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :BillOfMaterialsLine
                                          :CostEstimateForEachCostRuleTemplateApplicableToAQuotation
                                          :InventorySnapshot
                                          :MarketSignal
                                          :OverallCostEstimateForQuotation
                                          :PriceObservation
                                          :QCMeasurement
                                        )
                          ] ;
              rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/Magnitude> ;
              rdfs:comment "Canonical link from an entity to a gist:Magnitude (value+unit). Consolidated to avoid multiple scattered declarations."@en ;
              rdfs:label "has magnitude"@en .


###  http://www.apollo-procurement.org/ontology#hasNearestPort
:hasNearestPort rdf:type owl:ObjectProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :OwnManufacturingPlant
                                            :SupplierManufacturingPlant
                                          )
                            ] ;
                rdfs:label "has nearest port"@en .


###  http://www.apollo-procurement.org/ontology#hasOverallCostEstimateForQuotation
:hasOverallCostEstimateForQuotation rdf:type owl:ObjectProperty ;
                                    rdfs:domain :Quotation ;
                                    rdfs:range :OverallCostEstimateForQuotation ;
                                    rdfs:label "has effective factory door price"@en .


###  http://www.apollo-procurement.org/ontology#hasProcuredQuantity
:hasProcuredQuantity rdf:type owl:ObjectProperty ;
                     rdfs:domain :ProcurementSummary ;
                     rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/Magnitude> ;
                     rdfs:comment "Indicates the total quantity of material procured within the time period covered by this procurement summary."@en ;
                     rdfs:label "has procured quantity"@en .


###  http://www.apollo-procurement.org/ontology#hasQualityAspect
:hasQualityAspect rdf:type owl:ObjectProperty ;
                  rdfs:domain :MaterialRequiredForProduction ;
                  rdfs:range :QualityAspect ;
                  rdfs:comment "Links a Supplier Product to a quality aspect that can be measured( eg. purity water content, phValue etc)."@en ;
                  rdfs:label "has quality aspect"@en .


###  http://www.apollo-procurement.org/ontology#hasQuotedPrice
:hasQuotedPrice rdf:type owl:ObjectProperty ;
                rdfs:domain :Quotation ;
                rdfs:range :QuotedPrice ;
                rdfs:label "has quoted price"@en .


###  http://www.apollo-procurement.org/ontology#hasRMofRMDesc
:hasRMofRMDesc rdf:type owl:ObjectProperty ;
               rdfs:domain :RawMaterialofMaterialRequiredForProduction ;
               rdfs:range :RawMaterialofMaterialRequiredForProductionDesc ;
               rdfs:label "has Desc of Raw Material of Material Required For Production"@en .


###  http://www.apollo-procurement.org/ontology#hasRawMaterialDesc
:hasRawMaterialDesc rdf:type owl:ObjectProperty ;
                    rdfs:domain :MaterialRequiredForProduction ;
                    rdfs:range :ERPMaterialRequiredForProductionDesc ;
                    rdfs:label "has Chemical Description from ERP system"@en .


###  http://www.apollo-procurement.org/ontology#hasRecognizedEntity
:hasRecognizedEntity rdf:type owl:ObjectProperty ;
                     rdfs:domain :ContextualEntityOccurrence ;
                     rdfs:range owl:Thing ;
                     rdfs:comment "Links a contextual occurrence to an entity that was successfully recognized and resolved to a known concept in the knowledge graph."@en ;
                     rdfs:label "has recognized entity"@en .


###  http://www.apollo-procurement.org/ontology#hasResultCategory
:hasResultCategory rdf:type owl:ObjectProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :QCMeasurement
                                               :QualitySpecification
                                             )
                               ] ;
                   rdfs:range :ResultCategory ;
                   rdfs:comment "Associates either a quality specification or a QC measurement with a qualitative or categorical result, such as pass/fail, acceptable/ unacceptable, or conforms/does not conform. For QualitySpecification, this represents the required outcome. For QCMeasurement, this represents the observed outcome."@en ;
                   rdfs:label "has qualitative result category"@en .


###  http://www.apollo-procurement.org/ontology#hasShipmentMode
:hasShipmentMode rdf:type owl:ObjectProperty ;
                 rdfs:domain :Quotation ;
                 rdfs:range :ShipmentMode ;
                 rdfs:label "has shipment mode"@en .


###  http://www.apollo-procurement.org/ontology#hasSourceDocument
:hasSourceDocument rdf:type owl:ObjectProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :PotentialSupplier
                                               :Quotation
                                               :UnresolvedEntity
                                             )
                               ] ;
                   rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/Information> ;
                   rdfs:comment "Links a quotation to the email, PDF, or document in which the quotation was received."@en ;
                   rdfs:label "has source document"@en .


###  http://www.apollo-procurement.org/ontology#hasStatus
:hasStatus rdf:type owl:ObjectProperty ;
           rdfs:domain :ActionItem ;
           rdfs:range :ActionItemStatus .


###  http://www.apollo-procurement.org/ontology#hasSupplierParty
:hasSupplierParty rdf:type owl:ObjectProperty ;
                  rdfs:domain :SupplyAgreement ;
                  rdfs:range :Company ;
                  rdfs:label "has Supplier Party"@en .


###  http://www.apollo-procurement.org/ontology#hasTemporalExtent
:hasTemporalExtent rdf:type owl:ObjectProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :ApprovedSupplierAuthorization
                                               :Assertion
                                               :BillOfMaterials
                                               :MarketEvent
                                               :PriceObservation
                                               :ProcurementSummary
                                               :QualitySpecification
                                               :Quotation
                                               :SupplyAgreement
                                             )
                               ] ;
                   rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                   rdfs:comment "Associates an entity with the time period during which it is valid, applicable, or relevant. Used for prices, contracts, BOMs, quality specifications, assertions, forecasts and assessments."@en ;
                   rdfs:label "has temporal extent"@en .


###  http://www.apollo-procurement.org/ontology#hasThresholdMagnitude
:hasThresholdMagnitude rdf:type owl:ObjectProperty ;
                       rdfs:domain :QualitySpecification ;
                       rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/Magnitude> ;
                       rdfs:comment "Specifies the numeric threshold value and unit that defines the acceptable limit for a quality aspect."@en ;
                       rdfs:label "has threshold magnitude"@en .


###  http://www.apollo-procurement.org/ontology#hasTransactionPrice
:hasTransactionPrice rdf:type owl:ObjectProperty ;
                     rdfs:domain :ProcurementSummary ;
                     rdfs:range :TransactionPrice ;
                     rdfs:comment "Indicates the material, plant, supplier, currency, date and price value for which the procurement was done."@en ;
                     rdfs:label "Transaction Price"@en .


###  http://www.apollo-procurement.org/ontology#hasUnresolvedEntity
:hasUnresolvedEntity rdf:type owl:ObjectProperty ;
                     rdfs:domain :ContextualEntityOccurrence ;
                     rdfs:range :UnresolvedEntity ;
                     rdfs:comment "Links a contextual occurrence to an entity that could not be resolved to a known concept at ingestion time."@en ;
                     rdfs:label "has unresolved entity"@en .


###  http://www.apollo-procurement.org/ontology#hasUpperBoundMagnitude
:hasUpperBoundMagnitude rdf:type owl:ObjectProperty ;
                        rdfs:domain :QualitySpecification ;
                        rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/Magnitude> ;
                        rdfs:comment "Specifies the upper bound of an acceptable numeric range for a quality aspect."@en ;
                        rdfs:label "has upper bound magnitude"@en .


###  http://www.apollo-procurement.org/ontology#hasphysicallocation
:hasphysicallocation rdf:type owl:ObjectProperty ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( :Company
                                                 :NearestPort
                                                 :OwnManufacturingPlant
                                                 :SupplierManufacturingPlant
                                               )
                                 ] ;
                     rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/GeoLocation> ;
                     rdfs:label "plant or company is locatd at"@en .


###  http://www.apollo-procurement.org/ontology#influencedByDemandSignal
:influencedByDemandSignal rdf:type owl:ObjectProperty ;
                          rdfs:domain :ForecastedPrice ;
                          rdfs:range :DemandSignal ;
                          rdfs:label "Demand signal that influences forecast price"@en .


###  http://www.apollo-procurement.org/ontology#influencedBySupplySignal
:influencedBySupplySignal rdf:type owl:ObjectProperty ;
                          rdfs:domain :ForecastedPrice ;
                          rdfs:range :SupplySignal ;
                          rdfs:label "Supply signal that influences forecast price"@en .


###  http://www.apollo-procurement.org/ontology#involvesOrganization
:involvesOrganization rdf:type owl:ObjectProperty ;
                      rdfs:domain :MarketEvent ,
                                  :Meeting ;
                      rdfs:range :Company ,
                                 <https://w3id.org/semanticarts/ns/ontology/gist/Organization> ;
                      rdfs:comment "Indicates an organization that participated in the meeting."@en ;
                      rdfs:label "involves company"@en ,
                                 "involves organization"@en .


###  http://www.apollo-procurement.org/ontology#isASupplierOf
:isASupplierOf rdf:type owl:ObjectProperty ;
               rdfs:domain :PotentialSupplier ;
               rdfs:range :MaterialRequiredForProduction ;
               rdfs:label "Is a supplier of MaterialRequiredForProduction. "@en .


###  http://www.apollo-procurement.org/ontology#isAbout
:isAbout rdf:type owl:ObjectProperty ;
         rdfs:domain :Assertion ;
         rdfs:range owl:Thing ;
         rdfs:comment "Indicates the entity, entities, or phenomena that the assertion is about, such as a material, supplier, factory, market, event, or region."@en ;
         rdfs:label "is about"@en .


###  http://www.apollo-procurement.org/ontology#isAssociatedWithOwnManufacturingPlant
:isAssociatedWithOwnManufacturingPlant rdf:type owl:ObjectProperty ;
                                       rdfs:domain :LogisticsRoute ;
                                       rdfs:range :OwnManufacturingPlant ;
                                       rdfs:comment "Specifies the OwnManufacturingPlant that the route serves."@en ;
                                       rdfs:label "plant the route serves"@en .


###  http://www.apollo-procurement.org/ontology#isAssociatedWithSupplierManufacturingPlant
:isAssociatedWithSupplierManufacturingPlant rdf:type owl:ObjectProperty ;
                                            rdfs:domain :LogisticsRoute ;
                                            rdfs:range :SupplierManufacturingPlant ;
                                            rdfs:comment "Specifies the SupplierManufacturingPlant that the route starts at."@en ;
                                            rdfs:label "supplier plant the route starts at"@en .


###  http://www.apollo-procurement.org/ontology#isBrandedEquivalentFromSupplier
:isBrandedEquivalentFromSupplier rdf:type owl:ObjectProperty ;
                                 rdfs:domain :SupplierProduct ;
                                 rdfs:range :MaterialRequiredForProduction ;
                                 rdfs:comment "Suppliers' catalog item that is their branded equivalent of the MaterialRequiredForProduction."@en ;
                                 rdfs:label "supplier's branded equivalent" .


###  http://www.apollo-procurement.org/ontology#isSourcedFromSupplierManufacturingPlant
:isSourcedFromSupplierManufacturingPlant rdf:type owl:ObjectProperty ;
                                         rdfs:domain :SupplyAgreement ;
                                         rdfs:range :SupplierManufacturingPlant ;
                                         rdfs:comment "Indicates the supplier manufacturing plant(s) that are intended to ship the material under this supply agreement."@en ;
                                         rdfs:label "sourced from supplier plant"@en .


###  http://www.apollo-procurement.org/ontology#legDestination
:legDestination rdf:type owl:ObjectProperty ;
                rdfs:domain :LogisticsLeg ;
                rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/GeoLocation> ;
                rdfs:label "leg destination"@en .


###  http://www.apollo-procurement.org/ontology#legOrigin
:legOrigin rdf:type owl:ObjectProperty ;
           rdfs:domain :LogisticsLeg ;
           rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/GeoLocation> ;
           rdfs:label "leg origin"@en .


###  http://www.apollo-procurement.org/ontology#measuresMaterial
:measuresMaterial rdf:type owl:ObjectProperty ;
                  rdfs:domain :QCMeasurement ;
                  rdfs:range :SupplierProduct ;
                  rdfs:comment "Links a QC measurement to the specific supplier raw material (or sample) it measures." ;
                  rdfs:label "measures material" .


###  http://www.apollo-procurement.org/ontology#nameplateCapacity
:nameplateCapacity rdf:type owl:ObjectProperty ;
                   rdfs:domain :SupplierManufacturingPlant ;
                   rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/Magnitude> ;
                   rdfs:comment "The maximum production output (Quantity + Unit) per time period."@en ;
                   rdfs:label "Nameplate Capacity"@en .


###  http://www.apollo-procurement.org/ontology#observedFor
:observedFor rdf:type owl:ObjectProperty ;
             rdfs:domain :BenchmarkPrice ;
             rdfs:range [ rdf:type owl:Class ;
                          owl:unionOf ( :MaterialRequiredForProduction
                                        :RawMaterialofMaterialRequiredForProduction
                                      )
                        ] ;
             rdfs:comment "Links a price observation to the material it describes."@en ;
             rdfs:label "observed For"@en .


###  http://www.apollo-procurement.org/ontology#observedIn
:observedIn rdf:type owl:ObjectProperty ;
            rdfs:domain :BenchmarkPrice ;
            rdfs:range :InformationObject ;
            rdfs:label "observed in"@en .


###  http://www.apollo-procurement.org/ontology#observedMarket
:observedMarket rdf:type owl:ObjectProperty ;
                rdfs:domain :MarketSignal ;
                rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/GeoLocation> ;
                rdfs:label "observed market"@en .


###  http://www.apollo-procurement.org/ontology#observedMaterial
:observedMaterial rdf:type owl:ObjectProperty ;
                  rdfs:domain :MarketSignal ;
                  rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/CatalogItem> ;
                  rdfs:label "observed material"@en .


###  http://www.apollo-procurement.org/ontology#originatedFromMeeting
:originatedFromMeeting rdf:type owl:ObjectProperty ;
                       rdfs:domain :ActionItem ;
                       rdfs:range :Meeting ;
                       rdfs:comment "Indicates the meeting during which the action item was agreed."@en ;
                       rdfs:label "originated from meeting"@en .


###  http://www.apollo-procurement.org/ontology#ownsPlant
:ownsPlant rdf:type owl:ObjectProperty ;
           rdfs:domain :Company ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( :OwnManufacturingPlant
                                      :SupplierManufacturingPlant
                                    )
                      ] ;
           rdfs:label "owns Plant"@en .


###  http://www.apollo-procurement.org/ontology#performedAt
:performedAt rdf:type owl:ObjectProperty ;
             rdfs:domain :QCMeasurement ;
             rdfs:range :OwnManufacturingPlant ;
             rdfs:comment "Indicates the factory or laboratory where the QC measurement was performed."@en ;
             rdfs:label "performed at"@en .


###  http://www.apollo-procurement.org/ontology#procuredForPlant
:procuredForPlant rdf:type owl:ObjectProperty ;
                  rdfs:domain :ProcurementSummary ;
                  rdfs:range :OwnManufacturingPlant ;
                  rdfs:comment "The plant / factory mentioned on the PO or Invoice of the Transaction. "@en ;
                  rdfs:label "The plant this procurementwas for"@en .


###  http://www.apollo-procurement.org/ontology#procuredMaterial
:procuredMaterial rdf:type owl:ObjectProperty ;
                  rdfs:domain :ProcurementSummary ;
                  rdfs:range :MaterialRequiredForProduction ;
                  rdfs:comment "The raw material mentioned on the PO or Invoice of the Transaction. "@en ;
                  rdfs:label "The MaterialRequiredForProduction this procurementwas for. "@en .


###  http://www.apollo-procurement.org/ontology#producesItem
:producesItem rdf:type owl:ObjectProperty ;
              rdfs:domain :BillOfMaterialsLine ;
              rdfs:range :MaterialRequiredForProduction ;
              rdfs:label "produces Output Material"@en .


###  http://www.apollo-procurement.org/ontology#quotedForMaterial
:quotedForMaterial rdf:type owl:ObjectProperty ;
                   rdfs:domain :Quotation ;
                   rdfs:range :MaterialRequiredForProduction ;
                   rdfs:label "quoted for material"@en .


###  http://www.apollo-procurement.org/ontology#quotedQuantity
:quotedQuantity rdf:type owl:ObjectProperty ;
                rdfs:domain :Quotation ;
                rdfs:range <https://w3id.org/semanticarts/ns/ontology/gist/Magnitude> ;
                rdfs:label "quoted quantity"@en .


###  http://www.apollo-procurement.org/ontology#relatedMaterial
:relatedMaterial rdf:type owl:ObjectProperty ;
                 rdfs:domain :ActionItem ,
                             :Project ;
                 rdfs:range :MaterialRequiredForProduction ;
                 rdfs:comment "Links a project to the material(s) impacted by it."@en ,
                              "Links an action item to the material it impacts, if applicable."@en ;
                 rdfs:label "related material"@en .


###  http://www.apollo-procurement.org/ontology#relatedToMaterial
:relatedToMaterial rdf:type owl:ObjectProperty ;
                   rdfs:domain :Meeting ;
                   rdfs:range :MaterialRequiredForProduction ;
                   rdfs:comment "Links a meeting to the material discussed."@en ;
                   rdfs:label "related to project"@en .


###  http://www.apollo-procurement.org/ontology#relatedToProject
:relatedToProject rdf:type owl:ObjectProperty ;
                  rdfs:domain :ActionItem ,
                              :Meeting ;
                  rdfs:range :Project ;
                  rdfs:comment "Links a meeting to the project or initiative discussed."@en ,
                               "Links an action item to the project it supports."@en ;
                  rdfs:label "related to project"@en .


###  http://www.apollo-procurement.org/ontology#requiresParameter
:requiresParameter rdf:type owl:ObjectProperty ;
                   rdfs:domain :CostRuleTemplate ;
                   rdfs:range :CostRuleTemplateParameters ;
                   rdfs:comment "Indicates a required input parameter for evaluating this cost rule template, such as distance, quantity, HSN code, shipment mode, or route."@en ;
                   rdfs:label "requires parameter"@en .


###  http://www.apollo-procurement.org/ontology#responsibilityEndsAt
:responsibilityEndsAt rdf:type owl:ObjectProperty ;
                      rdfs:domain :Incoterm ;
                      rdfs:range :ResponsibilityBoundary ;
                      rdfs:comment "Defines the type of location where seller responsibility ends under this Incoterm, such as export port, import port, or named place."@en ;
                      rdfs:label "responsibility ends at"@en .


###  http://www.apollo-procurement.org/ontology#sellerBearsCost
:sellerBearsCost rdf:type owl:ObjectProperty ;
                 rdfs:domain :Incoterm ;
                 rdfs:range :CostComponent ;
                 rdfs:comment "Indicates a cost component that is the responsibility of the seller under this Incoterm® 2020."@en ;
                 rdfs:label "seller bears cost"@en .


###  http://www.apollo-procurement.org/ontology#specifiesAspect
:specifiesAspect rdf:type owl:ObjectProperty ;
                 rdfs:domain :QualitySpecification ;
                 rdfs:range :QualityAspect ;
                 rdfs:comment "Indicates the quality aspect (e.g., purity, pH, viscosity) to which this quality specification applies."@en ;
                 rdfs:label "specifies quality aspect"@en .


###  http://www.apollo-procurement.org/ontology#underSupplyAgreement
:underSupplyAgreement rdf:type owl:ObjectProperty ;
                      rdfs:domain :ProcurementSummary ;
                      rdfs:range :SupplyAgreement ;
                      rdfs:comment "The applicable supply agreement. "@en ;
                      rdfs:label "The applicable supply agreement. "@en .


###  http://www.apollo-procurement.org/ontology#usesInputMaterial
:usesInputMaterial rdf:type owl:ObjectProperty ;
                   rdfs:domain :BillOfMaterialsLine ;
                   rdfs:range :RawMaterialofMaterialRequiredForProduction ;
                   rdfs:label "uses Input Material"@en .


###  http://www.apollo-procurement.org/ontology#usesShipmentMode
:usesShipmentMode rdf:type owl:ObjectProperty ;
                  rdfs:domain :LogisticsLeg ;
                  rdfs:range :ShipmentMode ;
                  rdfs:label "uses shipment mode"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.apollo-procurement.org/ontology#assertionMadeAt
:assertionMadeAt rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Assertion ;
                 rdfs:range xsd:dateTime ;
                 rdfs:comment "The date and time when the assertion was issued or published (e.g., report release date)."@en ;
                 rdfs:label "assertion made at"@en .


###  http://www.apollo-procurement.org/ontology#assessmentMadeAt
:assessmentMadeAt rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Assessment ;
                  rdfs:range xsd:dateTime ;
                  rdfs:comment "The date and time when the assertion was issued or published (e.g., report release date)."@en ;
                  rdfs:label "Assessment made at"@en .


###  http://www.apollo-procurement.org/ontology#dueBy
:dueBy rdf:type owl:DatatypeProperty ;
       rdfs:domain :ActionItem ;
       rdfs:range xsd:date ;
       rdfs:comment "The target completion date for the action item."@en ;
       rdfs:label "due by date"@en .


###  http://www.apollo-procurement.org/ontology#hasStatus
:hasStatus rdf:type owl:DatatypeProperty .


###  http://www.apollo-procurement.org/ontology#inventoryDateTime
:inventoryDateTime rdf:type owl:DatatypeProperty ;
                   rdfs:domain :InventorySnapshot ;
                   rdfs:range xsd:dateTime ;
                   rdfs:comment "The date and time at which the Inventory data was pulled from ERP." ;
                   rdfs:label "Inventory dateTime" .


###  http://www.apollo-procurement.org/ontology#measurementDateTime
:measurementDateTime rdf:type owl:DatatypeProperty ;
                     rdfs:domain :QCMeasurement ;
                     rdfs:range xsd:dateTime ;
                     rdfs:comment "The date and time at which the QC measurement was performed." ;
                     rdfs:label "measurement dateTime" .


###  http://www.apollo-procurement.org/ontology#quotationDateTime
:quotationDateTime rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Quotation ;
                   rdfs:range xsd:dateTime ;
                   rdfs:comment "The date and time at which the Quotation was received from supplier." ;
                   rdfs:label "Quotation dateTime" .


###  http://www.apollo-procurement.org/ontology#snippetEvidence
:snippetEvidence rdf:type owl:DatatypeProperty ;
                 rdfs:domain owl:Thing ;
                 rdfs:range xsd:string ;
                 rdfs:comment "The exact text segment extracted from the source document that supports this fact/observation. Used for Grounding and RAG citations."@en ;
                 rdfs:label "Snippet Evidence"@en .


###  http://www.apollo-procurement.org/ontology#transactionDateTime
:transactionDateTime rdf:type owl:DatatypeProperty ;
                     rdfs:domain :ProcurementSummary ;
                     rdfs:range xsd:dateTime ;
                     rdfs:comment "The date and time at which the Procurement summary data was pulled from ERP." ;
                     rdfs:label "Procurement Summary dateTime" .


###  https://w3id.org/semanticarts/ns/ontology/gist/endDateTime
<https://w3id.org/semanticarts/ns/ontology/gist/endDateTime> rdf:type owl:DatatypeProperty ;
                                                             rdfs:domain <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                             rdfs:range xsd:dateTime ;
                                                             rdfs:label "end date and time"@en .


###  https://w3id.org/semanticarts/ns/ontology/gist/startDateTime
<https://w3id.org/semanticarts/ns/ontology/gist/startDateTime> rdf:type owl:DatatypeProperty ;
                                                               rdfs:domain <https://w3id.org/semanticarts/ns/ontology/gist/TemporalExtent> ;
                                                               rdfs:range xsd:dateTime ;
                                                               rdfs:label "start date and time"@en .


#################################################################
#    Classes
#################################################################

###  http://www.apollo-procurement.org/ontology#ActionItem
:ActionItem rdf:type owl:Class ;
            rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Commitment> ;
            rdfs:comment "A specific task or obligation agreed during a meeting, with an owner, due date, and expected outcome."@en ;
            rdfs:label "Action Item"@en .


###  http://www.apollo-procurement.org/ontology#ActionItemStatus
:ActionItemStatus rdf:type owl:Class ;
                  rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Category> ;
                  rdfs:label "Action Item Status"@en .


###  http://www.apollo-procurement.org/ontology#ApprovedSupplierAuthorization
:ApprovedSupplierAuthorization rdf:type owl:Class ;
                               rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Agreement> ;
                               rdfs:comment "A formal, time-bound authorization indicating that a supplier is approved to supply a specific material to a specific manufacturing plant. Approval defines eligibility, not commercial commitment."@en ;
                               rdfs:label "Approved Supplier Authorization"@en .


###  http://www.apollo-procurement.org/ontology#AshAspect
:AshAspect rdf:type owl:Class ;
           rdfs:subClassOf :QualityAspect ;
           rdfs:comment "Quality aspect representing inorganic residue (ash) (% w/w)" ;
           rdfs:label "Ash %"@en .


###  http://www.apollo-procurement.org/ontology#Assertion
:Assertion rdf:type owl:Class ;
           rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Information> ;
           rdfs:comment "A claim made by a source about an event, trend, expectation, or condition. Assertions may be uncertain, conflicting, or revised over time."@en ;
           rdfs:label "Assertion"@en .


###  http://www.apollo-procurement.org/ontology#Assessment
:Assessment rdf:type owl:Class ;
            rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Information> ;
            rdfs:comment "An evaluative interpretation derived from events, observations, and assertions, such as risk level, outlook, or impact analysis."@en ;
            rdfs:label "Assessment"@en .


###  http://www.apollo-procurement.org/ontology#AssessmentOutcome
:AssessmentOutcome rdf:type owl:Class ;
                   rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Category> ;
                   rdfs:comment "A controlled category representing the conclusion or decision resulting from an assessment, such as approve, reject, or shortlist."@en ;
                   rdfs:label "Assessment Outcome"@en .


###  http://www.apollo-procurement.org/ontology#BenchmarkPrice
:BenchmarkPrice rdf:type owl:Class ;
                rdfs:subClassOf :PriceObservation ;
                rdfs:comment "An external price assessment from a market report (e.g., Platts)."@en ;
                rdfs:label "Benchmark Price"@en .


###  http://www.apollo-procurement.org/ontology#BillOfMaterials
:BillOfMaterials rdf:type owl:Class ;
                 rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Collection> ;
                 rdfs:comment "A logical collection representing a specific bill of materials (upstream feedstock RawMaterialofMaterialRequiredForProduction) definition for a product. A Bill of Materials groups multiple BillOfMaterialsLine individuals, each of which specifies one input material and its required quantity. The Bill of Materials itself does not carry quantity information."@en ;
                 rdfs:label "Bill of Materials"@en .


###  http://www.apollo-procurement.org/ontology#BillOfMaterialsLine
:BillOfMaterialsLine rdf:type owl:Class ;
                     rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Relation> ;
                     rdfs:comment "An n-ary relationship representing one component entry in a bill of materials. A BillOfMaterialsLine specifies the consumption of a particular RawMaterialofMaterialRequiredForProduction, including the required quantity and unit of measure, to produce a specific finished good. Quantity and other contextual attributes apply at the level of the BillOfMaterialsLine."@en ;
                     rdfs:label "Bill of Materials Line"@en .


###  http://www.apollo-procurement.org/ontology#CASNumber
:CASNumber rdf:type owl:Class ;
           rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/ID> ;
           rdfs:comment "Unique numerical identifier assigned by the Chemical Abstracts Service."@en ;
           rdfs:label "CAS Registry Number"@en .


###  http://www.apollo-procurement.org/ontology#CapacityAdditionEvent
:CapacityAdditionEvent rdf:type owl:Class ;
                       rdfs:subClassOf :MarketEvent ;
                       rdfs:label "Capacity Addition Event"@en .


###  http://www.apollo-procurement.org/ontology#CapacitySignal
:CapacitySignal rdf:type owl:Class ;
                rdfs:subClassOf :MarketSignal ;
                rdfs:comment "An observed signal related to production capacity utilization, additions, shutdowns, or constraints."@en ;
                rdfs:label "Capacity Signal"@en .


###  http://www.apollo-procurement.org/ontology#Company
:Company rdf:type owl:Class ;
         rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Organization> ;
         rdfs:comment "A commercial business entity. Can act as both supplier and customer."@en ;
         rdfs:label "Company"@en .


###  http://www.apollo-procurement.org/ontology#ComparisonOperator
:ComparisonOperator rdf:type owl:Class ;
                    rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Category> ;
                    rdfs:comment "A controlled category representing a logical or mathematical operator used to compare a measured value against a specified criterion."@en ;
                    rdfs:label "Comparison Operator"@en .


###  http://www.apollo-procurement.org/ontology#ConfidenceLevel
:ConfidenceLevel rdf:type owl:Class ;
                 rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Category> ;
                 rdfs:comment "A qualitative classification indicating the reliability of an assessment or conclusion based on data completeness, source credibility, and recency."@en ;
                 rdfs:label "Confidence Level"@en .


###  http://www.apollo-procurement.org/ontology#ContextualEntityOccurrence
:ContextualEntityOccurrence rdf:type owl:Class ;
                            rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Event> ;
                            rdfs:comment "An extraction event representing the co-occurrence of recognized and unresolved entities within the same textual or semantic context during document ingestion."@en ;
                            rdfs:label "Contextual Entity Occurrence"@en .


###  http://www.apollo-procurement.org/ontology#ContractedPrice
:ContractedPrice rdf:type owl:Class ;
                 rdfs:subClassOf :PriceObservation ;
                 rdfs:comment "A binding price agreed upon as part of a SupplyAgreement. Represents contractual commercial terms, distinct from quoted, benchmark, forecasted, or transaction prices."@en ;
                 rdfs:label "Contracted Price"@en .


###  http://www.apollo-procurement.org/ontology#CostComponent
:CostComponent rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Category> ;
               rdfs:comment "A distinct cost element incurred in supplying goods from seller to buyer, such as freight, insurance, duties, or inland transport. Used to explicitly allocate cost responsibility under Incoterms."@en ;
               rdfs:label "Cost Component"@en .


###  http://www.apollo-procurement.org/ontology#CostComponentsApplicableToAQuotation
:CostComponentsApplicableToAQuotation rdf:type owl:Class ;
                                      rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Information> ;
                                      rdfs:comment "All the cost components that are applicble to the quotation."@en ;
                                      rdfs:label "Cost Components of a Quotation."@en .


###  http://www.apollo-procurement.org/ontology#CostEstimateForEachCostRuleTemplateApplicableToAQuotation
