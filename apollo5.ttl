#################################################################
#    Classes (Price & Economics) - Begin
#################################################################

###  http://www.apollo-procurement.org/ontology#PriceObservation
:PriceObservation rdf:type owl:Class ;
                  rdfs:subClassOf gist:Information ;
                  rdfs:comment "A data record capturing a specific price point, at a specific time, from a specific source."@en ;
                  rdfs:label "Price Observation"@en .

###  http://www.apollo-procurement.org/ontology#TransactionPrice
:TransactionPrice rdf:type owl:Class ;
                  rdfs:subClassOf :PriceObservation ;
                  rdfs:comment "An internal, realized price from a PO or Invoice."@en ;
                  rdfs:label "Transaction Price"@en .

###  http://www.apollo-procurement.org/ontology#BenchmarkPrice
:BenchmarkPrice rdf:type owl:Class ;
                rdfs:subClassOf :PriceObservation ;
                rdfs:comment "An external price assessment from a market report (e.g., Platts)."@en ;
                rdfs:label "Benchmark Price"@en .

###  http://www.apollo-procurement.org/ontology#ForecastedPrice
:ForecastedPrice rdf:type owl:Class ;
                 rdfs:subClassOf :PriceObservation ;
                 rdfs:comment "A predicted future price."@en ;
                 rdfs:label "Forecasted Price"@en .

###Pl. also see QuotedPrice under the Quotation class.

###  http://www.apollo-procurement.org/ontology#ContractedPrice
:ContractedPrice rdf:type owl:Class ;
				  rdfs:subClassOf :PriceObservation ;
				  rdfs:label "Contracted Price"@en ;
				  rdfs:comment "A binding price agreed upon as part of a SupplyAgreement. Represents contractual commercial terms, distinct from quoted, benchmark, forecasted, or transaction prices."@en .

#################################################################
#    Classes (Price & Economics) - End
#################################################################




#################################################################
#    Object Properties - (Price & Economics) - Begin
#################################################################

###  http://www.apollo-procurement.org/ontology#observedFor
:observedFor rdf:type owl:ObjectProperty ;
             rdfs:domain :BenchmarkPrice ;
             rdfs:range [ rdf:type owl:Class ;
                          owl:unionOf ( :RawMaterialofMaterialRequiredForProduction :MaterialRequiredForProduction ) ] ;
             rdfs:comment "Links a price observation to the material it describes."@en ;
             rdfs:label "observed For"@en .

:observedIn rdf:type owl:ObjectProperty ;
				  rdfs:domain :BenchmarkPrice ;
				  rdfs:range :InformationObject ;
				  rdfs:label "observed in"@en .
###InformationObject is defined later in the script.

###  http://www.apollo-procurement.org/ontology#applicableLocation
:applicableLocation rdf:type owl:ObjectProperty ;
                    rdfs:domain :BenchmarkPrice ;
                    rdfs:range gist:GeoLocation ;
                    rdfs:comment "The region, country, or plant where this price is valid."@en ;
                    rdfs:label "has Location of Price Obervation"@en .

###  http://www.apollo-procurement.org/ontology#hasCurrency
:hasCurrency rdf:type owl:ObjectProperty ;
             rdfs:domain :PriceObservation ;
             rdfs:range gist:Currency ;
             rdfs:label "has Currency of Price Observation"@en .

######  http://www.apollo-procurement.org/ontology#applicableLocation
:applicablePlant rdf:type owl:ObjectProperty ;
                    rdfs:domain  [ rdf:type owl:Class ;
					owl:unionOf ( :Quotation :ContractedPrice)] ;
                    rdfs:range :OwnManufacturingPlant ;
                    rdfs:comment "The plant / factory mentioned on the PO or Invoice of the Transaction. "@en ;
                    rdfs:label "The plant this price is valid for"@en .

:influencedBySupplySignal rdf:type owl:ObjectProperty ;
			  rdfs:domain :ForecastedPrice ;
			  rdfs:range :SupplySignal ;
			  rdfs:label "Supply signal that influences forecast price"@en .

:influencedByDemandSignal rdf:type owl:ObjectProperty ;
			  rdfs:domain :ForecastedPrice ;
			  rdfs:range :DemandSignal ;
			  rdfs:label "Demand signal that influences forecast price"@en .

:forecastedForRegion rdf:type owl:ObjectProperty ;
				  rdfs:domain :ForecastedPrice ;
				  rdfs:range gist:GeoLocation ;
				  rdfs:label "observed market"@en .

:forecastedForMaterial rdf:type owl:ObjectProperty ;
				  rdfs:domain :ForecastedPrice ;
				  rdfs:range :MaterialRequiredForProduction ;
				  rdfs:label "MaterialRequiredForProduction forecasted for. "@en .


			  
