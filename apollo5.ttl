                                                           rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Magnitude> ;
                                                           rdfs:comment "An estimated cost value for each appliable cost rule template applicable to the quotation."@en ;
                                                           rdfs:label "Cost Estimate"@en .


###  http://www.apollo-procurement.org/ontology#CostRuleTemplate
:CostRuleTemplate rdf:type owl:Class ;
                  rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Information> ;
                  rdfs:comment "A reusable rule definition describing how a cost component is calculated and which parameters influence it. CostRuleTemplate represents logic, not instantiated market values."@en ;
                  rdfs:label "Cost Rule Template"@en .


###  http://www.apollo-procurement.org/ontology#CostRuleTemplateParameters
:CostRuleTemplateParameters rdf:type owl:Class ;
                            rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Category> ;
                            rdfs:comment "A controlled vocabulary of parameters that are used in CostRuleTemplate."@en ;
                            rdfs:label "Cost Rule Template Parameters"@en .


###  http://www.apollo-procurement.org/ontology#CostRuleTemplatesApplicableToAQuotation
:CostRuleTemplatesApplicableToAQuotation rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Information> ;
                                         rdfs:comment "All the Cost rules templates applicable to a Quotation."@en ;
                                         rdfs:label "Cost rule templates applicable to a Quotation."@en .


###  http://www.apollo-procurement.org/ontology#DUNSNumber
:DUNSNumber rdf:type owl:Class ;
            rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/ID> ;
            rdfs:comment "nine-digit identifier for businesses, issued by Dun & Bradstreet (D&B)."@en ;
            rdfs:label "Data Universal Numbering System"@en .


###  http://www.apollo-procurement.org/ontology#DemandSignal
:DemandSignal rdf:type owl:Class ;
              rdfs:subClassOf :MarketSignal ;
              rdfs:comment "An observed signal indicating changes in demand conditions, such as growth, slowdown, or substitution effects."@en ;
              rdfs:label "Demand Signal"@en .


###  http://www.apollo-procurement.org/ontology#ERPMaterialRequiredForProductionDesc
:ERPMaterialRequiredForProductionDesc rdf:type owl:Class ;
                                      rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/PhysicalSubstance> ;
                                      rdfs:comment "The generic class defined by common properties (e.g., 'Caustic Soda 50%' or '5 Farad Capacitor')."@en ;
                                      rdfs:label "ERP Desc of Material Required for Production"@en .


###  http://www.apollo-procurement.org/ontology#ERPMaterialRequiredForProductionID
:ERPMaterialRequiredForProductionID rdf:type owl:Class ;
                                    rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/ID> ;
                                    rdfs:comment "The ID used in the buyer's internal ERP (e.g., SAP Material Master)."@en ;
                                    rdfs:label "ERP ID of Material Required For Production"@en .


###  http://www.apollo-procurement.org/ontology#FinancialReport
:FinancialReport rdf:type owl:Class ;
                 rdfs:subClassOf :InformationObject ;
                 rdfs:label "Financial / Subscription Report"@en .


