                               rdfs:comment "Canonical procurement material used for sourcing, pricing, quality, and risk analysis."@en ;
                               rdfs:label "Material Required For Production"@en .


###  http://www.apollo-procurement.org/ontology#Meeting
:Meeting rdf:type owl:Class ;
         rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Event> ;
         rdfs:comment "A formal or informal interaction between two or more parties where topics are discussed, decisions are made, and commitments or action items may be agreed."@en ;
         rdfs:label "Meeting"@en .


###  http://www.apollo-procurement.org/ontology#MeetingMinutes
:MeetingMinutes rdf:type owl:Class ;
                rdfs:subClassOf :InformationObject ;
                rdfs:label "Meeting Minutes"@en .


###  http://www.apollo-procurement.org/ontology#NearestPort
:NearestPort rdf:type owl:Class ;
             rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/GeoLocation> ;
             rdfs:comment "The port that is close by and is usually used by SupplierManufacturingPlant to ship goods from or by OwnManufacturingPlant to receive goods."@en ;
             rdfs:label "Nearest Port"@en .


###  http://www.apollo-procurement.org/ontology#OverallCostEstimateForQuotation
:OverallCostEstimateForQuotation rdf:type owl:Class ;
                                 rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Magnitude> ;
                                 rdfs:comment "The total estimated per unit cost value for a quotation, most often representing the effective factory door price per unit."@en ;
                                 rdfs:label "Over all cost Estimate for the quotation"@en .


###  http://www.apollo-procurement.org/ontology#OwnManufacturingPlant
:OwnManufacturingPlant rdf:type owl:Class ;
                       rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Organization> ;
                       rdfs:comment "The operational unit responsible for production. It has capacity & 'occupies' a Geographic Location. This is from Plant Mastr in ERP"@en ;
                       rdfs:label "Own Manufacturing Plant"@en .


###  http://www.apollo-procurement.org/ontology#OwnManufacturingPlantID
:OwnManufacturingPlantID rdf:type owl:Class ;
                         rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/ID> ;
                         rdfs:comment "The operational unit responsible for production. It 'has' a gist:Location. This is from Plant Mastr in ERP"@en ;
                         rdfs:label "Own Manufacturing Plant"@en .


###  http://www.apollo-procurement.org/ontology#PotentialSupplier
:PotentialSupplier rdf:type owl:Class ;
                   rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Information> ;
                   rdfs:comment "An potential supplier for a MaterialRequiredForProduction, who is not currently approved or known."@en ;
                   rdfs:label "Potential Supplier"@en .


###  http://www.apollo-procurement.org/ontology#PriceObservation
:PriceObservation rdf:type owl:Class ;
                  rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Information> ;
                  rdfs:comment "A data record capturing a specific price point, at a specific time, from a specific source."@en ;
                  rdfs:label "Price Observation"@en .


###  http://www.apollo-procurement.org/ontology#ProcessImprovementProject
:ProcessImprovementProject rdf:type owl:Class ;
                           rdfs:subClassOf :Project ;
                           rdfs:comment "A collaborative project between customer and supplier aimed at improving productivity, quality, consistency, or cost at a manufacturing facility."@en ;
                           rdfs:label "Process Improvement Project"@en .


###  http://www.apollo-procurement.org/ontology#ProcurementSummary
:ProcurementSummary rdf:type owl:Class ;
                    rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Information> ;
                    rdfs:comment "An aggregated and interpreted view of historical procurement transactions, derived from ERP data, and used for analysis and decision-making."@en ;
                    rdfs:label "Procurement Summary"@en .


###  http://www.apollo-procurement.org/ontology#Project
:Project rdf:type owl:Class ;
         rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Plan> ;
         rdfs:comment "A structured initiative or program with defined objectives, scope, and expected outcomes, often spanning multiple meetings and actions."@en ;
         rdfs:label "Project"@en .


###  http://www.apollo-procurement.org/ontology#PurityAspect
:PurityAspect rdf:type owl:Class ;
              rdfs:subClassOf :QualityAspect ;
              rdfs:comment "Quality aspect representing purity or assay (e.g., % active, % glycerol)" ;
              rdfs:label "Purity"@en .


###  http://www.apollo-procurement.org/ontology#QCMeasurement
:QCMeasurement rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Event> ;
               rdfs:comment "An event in which a quality aspect of a material or supplier product is measured, producing an observed value with a unit of measure.QCMeasurement captures when, where, and on which sample the measurementwas performed."@en ;
               rdfs:label "Quality Control Measurement"@en .


###  http://www.apollo-procurement.org/ontology#QualityAspect
:QualityAspect rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Aspect> ;
               rdfs:comment "A measurable or assessable quality dimension of a material or supplier product, such as purity, pH, viscosity, color, or impurity level."@en ;
               rdfs:label "Quality Aspect"@en .


###  http://www.apollo-procurement.org/ontology#QualitySpecification
:QualitySpecification rdf:type owl:Class ;
                      rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Specification> ;
                      rdfs:comment "A formal requirement that defines acceptable limits or conditions for a specific quality aspect of a material or supplier product. A Quality Specification represents what is required, not what was observed."@en ;
                      rdfs:label "Quality Specification"@en .


###  http://www.apollo-procurement.org/ontology#Quotation
:Quotation rdf:type owl:Class ;
           rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/Offer> ;
           rdfs:label "Quotation"@en .


