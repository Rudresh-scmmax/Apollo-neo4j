###  http://www.apollo-procurement.org/ontology#Asn_CPO_B40_GlycerineCoproduction
:Asn_CPO_B40_GlycerineCoproduction rdf:type owl:NamedIndividual ,
                                            :Assertion ;
                                   :assertedIn :News_CPO_IndonesiaBiodieselB40 ;
                                   :assertionConfidence :HighConfidence ;
                                   :drivenBy :CapacityExpansion ,
                                             :DemandGrowth ;
                                   :isAbout :CrudePalmOil ,
                                            :GlycerineRefined ;
                                   :assertionMadeAt "2025-01-10T00:00:00Z"^^xsd:dateTime ;
                                   :snippetEvidence "Indonesia's B40 biodiesel mandate effective January 2025 will increase CPO-based biodiesel output by an estimated 3 million MT/yr, generating approximately 300,000 MT of additional crude glycerine annually as co-product." ;
                                   rdfs:label "Assertion: Indonesia B40 Biodiesel Mandate to Boost Glycerine Co-production"@en .


###  http://www.apollo-procurement.org/ontology#Asn_CPO_PriceRise_2025
:Asn_CPO_PriceRise_2025 rdf:type owl:NamedIndividual ,
                                 :Assertion ;
                        :assertedIn :Rpt_MPOB_CPO_2025 ;
                        :assertionConfidence :HighConfidence ;
                        :drivenBy :FeedstockCostChange ;
                        :isAbout :CrudePalmOil ,
                                 :GlycerineRefined ;
                        :assertionMadeAt "2025-02-01T00:00:00Z"^^xsd:dateTime ;
                        :snippetEvidence "CPO prices have risen 15% year-on-year to USD 940/MT FOB in January 2025, driven by La Niña production impacts and strong biodiesel demand; this raises the production cost floor for oleochemical glycerine, partially offsetting downward price pressure from oversupply." ;
                        rdfs:label "Assertion: Rising CPO prices in 2025 increasing glycerine production cost floor"@en .


###  http://www.apollo-procurement.org/ontology#Asn_CausticSodaDown_2025
:Asn_CausticSodaDown_2025 rdf:type owl:NamedIndividual ,
                                   :Assertion ;
                          :assertedIn :Rpt_PlattsOleo_2025 ;
                          :assertionConfidence :MediumConfidence ;
                          :drivenBy :FeedstockCostChange ;
                          :isAbout :CausticSoda ,
                                   :GlycerineRefined ;
                          :assertionMadeAt "2025-03-01T00:00:00Z"^^xsd:dateTime ;
                          :snippetEvidence "Global caustic soda prices have softened to USD 295/MT CFR India in January 2025 from USD 320/MT in January 2024, reducing saponification process input costs for glycerine producers and improving margins at current glycerine prices." ;
                          rdfs:label "Assertion: Caustic soda prices declining in 2025, reducing glycerine production input costs"@en .


