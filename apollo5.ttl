:RawMaterialofMaterialRequiredForProductionID rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/semanticarts/ns/ontology/gist/ID> ;
                                              rdfs:comment "This is the internal id for the upstream input (feedstock) used by the supplier to manufacture the Raw Material needed for production.This is given by user or updated by Apollo."@en ;
                                              rdfs:label "ID for Raw Material of the upstream feedstock"@en .


