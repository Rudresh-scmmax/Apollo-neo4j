@prefix : <http://www.apollo-procurement.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix gist: <https://w3id.org/semanticarts/ns/ontology/gist/> .

<http://www.apollo-procurement.org/ontology> rdf:type owl:Ontology ;
                                             owl:imports <https://w3id.org/semanticarts/ontology/gistCore> ;
                                             rdfs:comment "The Apollo Procurement Ontology. Complete version supporting Price Forecasting, Drivers, Substitution, Risk, and BOM."@en ;
                                             rdfs:label "Apollo Procurement Ontology"@en .

###Version dated 22-Dec-2025 - Started version control
###Version dated 23-Dec-2025 - Added ApprovedSupplierAuthorization section; Added basedOnApproval relation to SupplyAgreement
###Version dated 24-Dec-2025 - Added ContextualEntityOccurrence class; hasUnresolvedEntity, hasRecognizedEntity;
###Version dated 24-Dec-2025 - Added ContractedPrice class; added applicableToPlant and hasContractedPrice to SupplyAgreement
###Version dated 24-Dec-2025 - Added hasProcuredQuantity

#################################################################
#    Object property (Time Validity / Temporal Extent - Begin)
#################################################################

:hasTemporalExtent rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :PriceObservation :SupplyAgreement :BillOfMaterials :QualitySpecification :Assertion :ApprovedSupplierAuthorization :Quotation :MarketEvent :ProcurementSummary) ] ;
    rdfs:range gist:TemporalExtent ;
    rdfs:label "has temporal extent"@en ;
    rdfs:comment "Associates an entity with the time period during which it is valid, applicable, or relevant. Used for prices, contracts, BOMs, quality specifications, assertions, forecasts and assessments."@en .


#################################################################
#    Object property (Time Validity / Temporal Extent- End)
#################################################################


#################################################################
#    Data property (Time Validity / Temporal Extent- Begin)
#################################################################

gist:startDateTime rdf:type owl:DatatypeProperty ;
    rdfs:domain gist:TemporalExtent ;
    rdfs:range xsd:dateTime ;
    rdfs:label "start date and time"@en .

gist:endDateTime rdf:type owl:DatatypeProperty ;
    rdfs:domain gist:TemporalExtent ;
    rdfs:range xsd:dateTime ;
    rdfs:label "end date and time"@en .


#################################################################
#    Data property (Time Validity / Temporal Extent- End)
#################################################################

#################################################################
# Canonical magnitude & Location property (consolidated) - Begin
#################################################################
:hasMagnitude rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf gist:hasMagnitude ;
    rdfs:label "has magnitude"@en ;
    rdfs:comment "Canonical link from an entity to a gist:Magnitude (value+unit). Consolidated to avoid multiple scattered declarations."@en ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( :BillOfMaterialsLine :PriceObservation :QCMeasurement :MarketSignal :InventorySnapshot :CostEstimateForEachCostRuleTemplateApplicableToAQuotation :OverallCostEstimateForQuotation) ] ;
    rdfs:range gist:Magnitude .


:hasphysicallocation rdf:type owl:ObjectProperty ;
                  rdfs:domain  [ rdf:type owl:Class ;
				  owl:unionOf ( :OwnManufacturingPlant :SupplierManufacturingPlant :Company :NearestPort)] ;
                  rdfs:range gist:GeoLocation ;
                  rdfs:label "plant or company is locatd at"@en .

:hasSourceDocument rdf:type owl:ObjectProperty ;
     rdfs:domain  [ rdf:type owl:Class ;
				  owl:unionOf ( :Quotation :PotentialSupplier :UnresolvedEntity)] ;
    rdfs:range gist:Information ;
    rdfs:label "has source document"@en ;
    rdfs:comment "Links a quotation to the email, PDF, or document in which the quotation was received."@en .




#################################################################
# Canonical magnitude & Location property (consolidated) - End
#################################################################


#################################################################
#    Classes (Unresolved Entity & ContextualEntityOccurrence - Begin)
#################################################################

:UnresolvedEntity rdf:type owl:Class ;
    rdfs:subClassOf gist:Information ;
    rdfs:label "Unresolved Entity"@en ;
    rdfs:comment "A temporary placeholder for an entity mentioned in text that cannot yet be confidently resolved to a canonical knowledge graph entity."@en .

:ContextualEntityOccurrence rdf:type owl:Class ;
    rdfs:subClassOf gist:Event ;
    rdfs:label "Contextual Entity Occurrence"@en ;
    rdfs:comment "An extraction event representing the co-occurrence of recognized and unresolved entities within the same textual or semantic context during document ingestion."@en .



#################################################################
#    Classes (Unresolved Entity & ContextualEntityOccurrence - End)
#################################################################

#################################################################
#    Object Property (Unresolved Entity - Begin)
#################################################################


:hasUnresolvedEntity rdf:type owl:ObjectProperty ;
    rdfs:domain :ContextualEntityOccurrence ;
    rdfs:range :UnresolvedEntity ;
    rdfs:label "has unresolved entity"@en ;
    rdfs:comment "Links a contextual occurrence to an entity that could not be resolved to a known concept at ingestion time."@en .

:hasRecognizedEntity rdf:type owl:ObjectProperty ;
    rdfs:domain :ContextualEntityOccurrence ;
    rdfs:range owl:Thing ;
    rdfs:label "has recognized entity"@en ;
    rdfs:comment "Links a contextual occurrence to an entity that was successfully recognized and resolved to a known concept in the knowledge graph."@en .

:entityRole rdf:type owl:ObjectProperty ;
    rdfs:domain :ContextualEntityOccurrence ;
    rdfs:range gist:Category ;
    rdfs:label "entity role in context"@en ;
    rdfs:comment "Indicates the semantic role an entity plays in the given context, such as supplier, material, plant, location, or event."@en .



#################################################################
#    Object Property (Unresolved Entity - End)
#################################################################



#################################################################
#    Data Property (Evidence Snippet - Begin)
#################################################################

:snippetEvidence rdf:type owl:DatatypeProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    rdfs:label "Snippet Evidence"@en ;
    rdfs:comment "The exact text segment extracted from the source document that supports this fact/observation. Used for Grounding and RAG citations."@en .



#################################################################
#    Data Property (Evidence Snippet - End)
#################################################################


#################################################################
# Class - Confidence Level - Begin
#################################################################

:ConfidenceLevel rdf:type owl:Class ;
    rdfs:subClassOf gist:Category ;
    rdfs:label "Confidence Level"@en ;
    rdfs:comment "A qualitative classification indicating the reliability of an assessment or conclusion based on data completeness, source credibility, and recency."@en .


#################################################################
# ConfidenceLevel  — instances / values - Begin
#################################################################

:HighConfidence rdf:type :ConfidenceLevel ;
    rdfs:label "High Confidence"@en ;
    rdfs:comment "Assessment is based on recent, complete, and reliable data from trusted sources."@en .

:MediumConfidence rdf:type :ConfidenceLevel ;
    rdfs:label "Medium Confidence"@en ;
    rdfs:comment "Assessment is based on partially complete or moderately reliable data, or includes reasonable assumptions."@en .

:LowConfidence rdf:type :ConfidenceLevel ;
    rdfs:label "Low Confidence"@en ;
    rdfs:comment "Assessment is based on limited, outdated, or uncertain data and should be interpreted cautiously."@en .

#################################################################
# ConfidenceLevel  — instances / values - End
#################################################################

#################################################################
# Class - Confidence Level - End
#################################################################

#################################################################
#    Classes (Fondational Entities that are associated with multiple entities like Quoation, SupplyAgreement, Contract etc - End)
#################################################################


:ShipmentMode rdf:type owl:Class ;
    rdfs:subClassOf gist:Category ;
    rdfs:label "Shipment Mode"@en ;
    rdfs:comment "Mode of transportation such as sea freight, air freight, road, or rail."@en .

#################################################################
# ShipmentMode   — instances / values - Begin
#################################################################

:SeaFreight rdf:type :ShipmentMode ;
    rdfs:label "Sea Freight"@en ;
    rdfs:comment "Transportation of goods by ocean-going vessels between seaports. Typically lowest cost per unit for bulk and containerized cargo, with longer transit times."@en .

:AirFreight rdf:type :ShipmentMode ;
    rdfs:label "Air Freight"@en ;
    rdfs:comment "Transportation of goods by aircraft between airports. Highest cost per unit, used for urgent, high-value, or time-sensitive shipments."@en .

:RoadTransport rdf:type :ShipmentMode ;
    rdfs:label "Road Transport"@en ;
    rdfs:comment "Transportation of goods by trucks over road networks. Common for domestic or regional movements and last-mile delivery."@en .

:RailTransport rdf:type :ShipmentMode ;
    rdfs:label "Rail Transport"@en ;
    rdfs:comment "Transportation of goods by rail. Cost-effective for long-distance inland movement of bulk or containerized cargo."@en .

:InlandWaterway rdf:type :ShipmentMode ;
    rdfs:label "Inland Waterway Transport"@en ;
    rdfs:comment "Transportation of goods via rivers, canals, or inland waterways. Used where navigable waterways exist, often lower cost but slower."@en .

:MultimodalTransport rdf:type :ShipmentMode ;
    rdfs:label "Multimodal Transport"@en ;
    rdfs:comment "Transportation using two or more shipment modes under a single logistics plan, such as sea plus road or rail plus road."@en .


#################################################################
# ShipmentMode   — instances / values - End
#################################################################


:GeopoliticalRegion rdf:type owl:Class ;
    rdfs:subClassOf gist:GeoRegion ;
    rdfs:label "Geopolitical Region"@en ;
    rdfs:comment "A country, trade zone, or geopolitical region relevant for logistics, trade, or regulation."@en .

:TradeAgreement rdf:type owl:Class ;
    rdfs:subClassOf gist:Category ;
    rdfs:label "Trade Agreement"@en ;
    rdfs:comment "A bilateral or multilateral trade agreement that influences import duties or tariffs."@en .


:NearestPort rdf:type owl:Class ;
    rdfs:subClassOf gist:GeoLocation ;
    rdfs:label "Nearest Port"@en ;
    rdfs:comment "The port that is close by and is usually used by SupplierManufacturingPlant to ship goods from or by OwnManufacturingPlant to receive goods."@en .



#################################################################
#    Classes (Fondational Entities that are associated with multiple entities like Quoation, SupplyAgreement, Contract etc - End)
#################################################################


#################################################################
#    Classes (Material Related - Begin)
#################################################################


###  http://www.apollo-procurement.org/ontology#RawMaterial
### The node that holds everything of a specific Material Required for Production together
:MaterialRequiredForProduction rdf:type owl:Class ;
    rdfs:subClassOf gist:CatalogItem ;
	rdfs:label "Material Required For Production"@en ;
    rdfs:comment "Canonical procurement material used for sourcing, pricing, quality, and risk analysis."@en .



###  http://www.apollo-procurement.org/ontology#RawMaterialID
:ERPMaterialRequiredForProductionID rdf:type owl:Class ;
    rdfs:subClassOf gist:ID ;
    rdfs:label "ERP ID of Material Required For Production"@en ;
    rdfs:comment "The ID used in the buyer's internal ERP (e.g., SAP Material Master)."@en .



###  http://www.apollo-procurement.org/ontology#RawMaterial
### The Tradable Item (What is actually bought)
:SupplierProduct rdf:type owl:Class ;
    rdfs:subClassOf gist:CatalogItem ;
    rdfs:label "Supplier Product (Trade Item)"@en ;
    rdfs:comment "The specific trade item sold by a supplier (e.g., 'Dow Caustic Grade A')."@en .



###  http://www.apollo-procurement.org/ontology#RawMaterial
### The Abstract Material (Chemistry/Category)
:ERPMaterialRequiredForProductionDesc rdf:type owl:Class ;
    rdfs:subClassOf gist:PhysicalSubstance ;
	rdfs:label "ERP Desc of Material Required for Production"@en ;
    rdfs:comment "The generic class defined by common properties (e.g., 'Caustic Soda 50%' or '5 Farad Capacitor')."@en .



###  http://www.apollo-procurement.org/ontology#RawMaterial
### The node that holds everything of a specific RMofRM together
:RawMaterialofMaterialRequiredForProduction rdf:type owl:Class ;
    rdfs:subClassOf gist:CatalogItem ;
	rdfs:label "Raw Material of Material Required For Production"@en ;
    rdfs:comment "This is the upstream input (feedstock) used by the supplier to manufacture the Material Required For Production."@en .




###  http://www.apollo-procurement.org/ontology#RawMaterialID
:RawMaterialofMaterialRequiredForProductionID rdf:type owl:Class ;
    rdfs:subClassOf gist:ID ;
    rdfs:label "ID for Raw Material of the upstream feedstock"@en ;
    rdfs:comment "This is the internal id for the upstream input (feedstock) used by the supplier to manufacture the Raw Material needed for production.This is given by user or updated by Apollo."@en .


###  http://www.apollo-procurement.org/ontology#RawMaterialOfRawMaterial
:RawMaterialofMaterialRequiredForProductionDesc rdf:type owl:Class ;
                          rdfs:subClassOf gist:PhysicalSubstance ;
                          rdfs:comment "Desc for Raw Material of the upstream feedstock."@en ;
                          rdfs:label "Common name for Raw Material of Material Required For Production"@en .

###  http://www.apollo-procurement.org/ontology#MaterialGroup
:MaterialGroupbyChemistry rdf:type owl:Class ;
               rdfs:subClassOf gist:Category ;
               rdfs:label "Material Group by Chemistry"@en ;
               rdfs:comment "A controlled category grouping materials based on their chemical structure or functional group, used for substitution analysis, risk assessment, and market intelligence."@en .


#################################################################
# MaterialGroupbyChemistry   — instances / values - Begin
#################################################################


:Alcohol rdf:type :MaterialGroupbyChemistry ;
    rdfs:label "Alcohol"@en ;
    rdfs:comment "Organic compounds characterized by the presence of one or more hydroxyl (-OH) groups."@en .

:Ketone rdf:type :MaterialGroupbyChemistry ;
    rdfs:label "Ketone"@en ;
    rdfs:comment "Organic compounds containing a carbonyl group bonded to two carbon atoms."@en .

:Surfactant rdf:type :MaterialGroupbyChemistry ;
    rdfs:label "Surfactant"@en ;
    rdfs:comment "Compounds that reduce surface or interfacial tension, commonly used in detergents, emulsifiers, and cleaners."@en .

#################################################################
# MaterialGroupbyChemistry   — instances / values - End
#################################################################


###  http://www.apollo-procurement.org/ontology#EndUseGroup
:MaterialGroupbyEndUse rdf:type owl:Class ;
             rdfs:subClassOf gist:Category ;
             rdfs:label "Material Group by End Use"@en ;
			 rdfs:comment "A controlled category grouping materials based on their industrial or functional application, independent of chemical structure. (e.g., Solvent, Adhesive)."@en .
             
			 
			 
#################################################################
# MaterialGroupbyEndUse   — instances / values - Begin
#################################################################


:Solvent rdf:type :MaterialGroupbyEndUse ;
    rdfs:label "Solvent"@en ;
    rdfs:comment "Materials primarily used to dissolve or disperse other substances in formulations or processes."@en .

:Adhesive rdf:type :MaterialGroupbyEndUse ;
    rdfs:label "Adhesive"@en ;
    rdfs:comment "Materials used to bond surfaces together."@en .

:Emulsifier rdf:type :MaterialGroupbyEndUse ;
    rdfs:label "Emulsifier"@en ;
    rdfs:comment "Materials used to stabilize mixtures of immiscible liquids."@en .

#################################################################
# MaterialGroupbyEndUse   — instances / values - End
#################################################################


###  http://www.apollo-procurement.org/ontology#BillOfMaterials
:BillOfMaterials rdf:type owl:Class ;
                 rdfs:subClassOf gist:Collection ; 
                 rdfs:comment "A logical collection representing a specific bill of materials (upstream feedstock RawMaterialofMaterialRequiredForProduction) definition for a product. A Bill of Materials groups multiple BillOfMaterialsLine individuals, each of which specifies one input material and its required quantity. The Bill of Materials itself does not carry quantity information."@en ;
                 rdfs:label "Bill of Materials"@en .

:BillOfMaterialsLine rdf:type owl:Class ;
                 rdfs:subClassOf gist:Relation ; 
                 rdfs:comment "An n-ary relationship representing one component entry in a bill of materials. A BillOfMaterialsLine specifies the consumption of a particular RawMaterialofMaterialRequiredForProduction, including the required quantity and unit of measure, to produce a specific finished good. Quantity and other contextual attributes apply at the level of the BillOfMaterialsLine."@en ;
                 rdfs:label "Bill of Materials Line"@en .



###  http://www.apollo-procurement.org/ontology#CASNumber
:CASNumber rdf:type owl:Class ;
    rdfs:subClassOf gist:ID ;
    rdfs:label "CAS Registry Number"@en ;
    rdfs:comment "Unique numerical identifier assigned by the Chemical Abstracts Service."@en .


###  http://www.apollo-procurement.org/ontology#CASNumber
:HSNCode rdf:type owl:Class ;
    rdfs:subClassOf gist:ID ;
    rdfs:label "HSN Number"@en ;
    rdfs:comment "Harmonized System of Nomenclature code, is a multi-digit numerical system developed by the World Customs Organization (WCO) "@en .

#################################################################
#    Classes (Material Related - End)
#################################################################



#################################################################
#    Object Properties - Material Related - Start
#################################################################


###  http://www.apollo-procurement.org/ontology#hasBillOfMaterials
:hasBillOfMaterials rdf:type owl:ObjectProperty ;
                    rdfs:domain :MaterialRequiredForProduction ;
                    rdfs:range :BillOfMaterials ;
                    rdfs:label "has Bill of Materials"@en ;
					rdfs:comment "Associates a finished good with a specific bill of materials definition that describes how the item is manufactured. The Bill of Materials groups one or more BillOfMaterialsLine individuals and does not itself specify component quantities."@en .



###  http://www.apollo-procurement.org/ontology#hasBillOfMaterialsLine
:hasBillOfMaterialsLine rdf:type owl:ObjectProperty ;
                    rdfs:domain :BillOfMaterials ;
                    rdfs:range :BillOfMaterialsLine ;
                    rdfs:label "has Bill of Materials Line" ;
					rdfs:comment "Links a Bill of Materials to its constituent BillOfMaterialsLine individuals. Each BillOfMaterialsLine represents one RawMaterialofMaterialRequiredForProduction entry, specifying an input material and the quantity required to produce the associated MaterialRequiredForProduction."@en .



###  http://www.apollo-procurement.org/ontology#usesInputMaterial
:usesInputMaterial rdf:type owl:ObjectProperty ;
                   rdfs:domain :BillOfMaterialsLine ;
                   rdfs:range :RawMaterialofMaterialRequiredForProduction ;
                   rdfs:label "uses Input Material"@en .

###  http://www.apollo-procurement.org/ontology#producesItem
:producesItem rdf:type owl:ObjectProperty ;
                   rdfs:domain :BillOfMaterialsLine ;
                   rdfs:range :MaterialRequiredForProduction ;
                   rdfs:label "produces Output Material"@en .

###    Magnitude for Bill of Material Line is  defined under :hasMagnitude right at the beginning

###    Bill of Material Valid from and Valid to dates are defined under :hasTemporalExtent right at the beginning

###  http://www.apollo-procurement.org/ontology#hasBillOfMaterials
:hasHSNCode rdf:type owl:ObjectProperty ;
                   rdfs:domain :MaterialRequiredForProduction ;
                   rdfs:range :HSNCode ;
                   rdfs:label "has a HSN Code"@en .


:isBrandedEquivalentFromSupplier rdf:type owl:ObjectProperty ;
				   rdfs:domain :SupplierProduct ;
				   rdfs:range :MaterialRequiredForProduction ;
				   rdfs:label "supplier's branded equivalent" ;
				   rdfs:comment "Suppliers' catalog item that is their branded equivalent of the MaterialRequiredForProduction."@en .				

###  http://www.apollo-procurement.org/ontology#belongsToGroup
:belongsToChemistryGroup rdf:type owl:ObjectProperty ;
					rdfs:domain :MaterialRequiredForProduction ;
					rdfs:range :MaterialGroupbyChemistry ;
					rdfs:label "belongs To Chemistry Group"@en .


:belongsToEndUseGroup rdf:type owl:ObjectProperty ;
					rdfs:domain :MaterialRequiredForProduction ;
					rdfs:range :MaterialGroupbyEndUse ;
					rdfs:label "belongs to end use group"@en ;
					rdfs:comment "Indicates the primary industrial or functional application of the material."@en .

###  http://www.apollo-procurement.org/ontology#belongsToGroup
:hasCASNumber rdf:type owl:ObjectProperty ;
				rdfs:domain :MaterialRequiredForProduction ;
				rdfs:range :CASNumber ;
				rdfs:label "has a CAS Number"@en .


###  http://www.apollo-procurement.org/ontology#hasERPMaterialID
:hasERPMaterialID rdf:type owl:ObjectProperty ;
                rdfs:domain :MaterialRequiredForProduction ;
                rdfs:range :ERPMaterialRequiredForProductionID ;
                rdfs:label "has a Material ID from Material Master in ERP"@en .



###  http://www.apollo-procurement.org/ontology#belongsToGroup
:belongsToEndUseGroup rdf:type owl:ObjectProperty ;
                rdfs:domain :MaterialRequiredForProduction ;
                rdfs:range :MaterialGroupbyEndUse ;
                rdfs:label "belongs To End use Group"@en .

###  http://www.apollo-procurement.org/ontology#hasChemicalIdentity
:hasRawMaterialDesc rdf:type owl:ObjectProperty ;
                     rdfs:domain :MaterialRequiredForProduction ;
                     rdfs:range :ERPMaterialRequiredForProductionDesc ;
                     rdfs:label "has Chemical Description from ERP system"@en .

###  http://www.apollo-procurement.org/ontology#hasChemicalIdentity
:hasRMofRMDesc rdf:type owl:ObjectProperty ;
                     rdfs:domain :RawMaterialofMaterialRequiredForProduction ;
                     rdfs:range :RawMaterialofMaterialRequiredForProductionDesc ;
                     rdfs:label "has Desc of Raw Material of Material Required For Production"@en .



#################################################################
#    Object Properties - Material Related - End
#################################################################
#################################################################
#    Data Properties - Material Related - Begin
#################################################################




#################################################################
#    Data Properties - Material Related - End
#################################################################

#################################################################
#    Classes (Company & Supplier Related - Begin)
#################################################################

### The node that holds everything of a specific company together
###  http://www.apollo-procurement.org/ontology#Company
:Company rdf:type owl:Class ;
         rdfs:subClassOf gist:Organization ;
         rdfs:comment "A commercial business entity. Can act as both supplier and customer."@en ;
         rdfs:label "Company"@en .

###  http://www.apollo-procurement.org/ontology#CASNumber
:DUNSNumber rdf:type owl:Class ;
    rdfs:subClassOf gist:ID ;
    rdfs:label "Data Universal Numbering System"@en ;
    rdfs:comment "nine-digit identifier for businesses, issued by Dun & Bradstreet (D&B)."@en .


:PotentialSupplier rdf:type owl:Class ;
				  rdfs:subClassOf gist:Information ;
				  rdfs:label "Potential Supplier"@en ;
				  rdfs:comment "An potential supplier for a MaterialRequiredForProduction, who is not currently approved or known."@en .



#################################################################
#    Classes (Company & Supplier Related - End)
#################################################################




#################################################################
#    Object Properties  (Company & Supplier Related - Begin)
#################################################################


###  for Location of company - see hasPhysicalLocation object property above.


###  http://www.apollo-procurement.org/ontology#hasCustomerParty
:hasDUNSNumber rdf:type owl:ObjectProperty ;
                  rdfs:domain :Company ;
                  rdfs:range :DUNSNumber ;
                  rdfs:label "Company has DUNS Number"@en .



:isASupplierOf rdf:type owl:ObjectProperty ;
                  rdfs:domain :PotentialSupplier ;
                  rdfs:range :MaterialRequiredForProduction ;
                  rdfs:label "Is a supplier of MaterialRequiredForProduction. "@en .

###Source Document of PotentialSupplier is linked above in hasSourceDocument in foundational section above.

#################################################################
#    Object Properties  (Company & Supplier Related - End)
#################################################################




#################################################################
#    Data Properties - Company & Supplier related - Begin
#################################################################




#################################################################
#    Data Properties - Company & Supplier related - End
#################################################################



#################################################################
#    Classes (Manufacturing Plant - Begin)
#################################################################
### The node that holds everything of a specific manufacturing plant together
:OwnManufacturingPlant rdf:type owl:Class ;
    rdfs:subClassOf gist:Organization ;
    rdfs:label "Own Manufacturing Plant"@en ;
    rdfs:comment "The operational unit responsible for production. It has capacity & 'occupies' a Geographic Location. This is from Plant Mastr in ERP"@en .


:OwnManufacturingPlantID rdf:type owl:Class ;
    rdfs:subClassOf gist:ID ;
    rdfs:label "Own Manufacturing Plant"@en ;
    rdfs:comment "The operational unit responsible for production. It 'has' a gist:Location. This is from Plant Mastr in ERP"@en .



### The node that holds everything of a specific supplier manufacturing plant together
:SupplierManufacturingPlant rdf:type owl:Class ;
    rdfs:subClassOf gist:Organization ;
    rdfs:label "Supplier Manufacturing Plant"@en ;
    rdfs:comment "The operational unit responsible for production at the supplier end. It has capacity & 'occupies' a Geographic Location. This is from intelligence gathered from manual input / market research reports / emails or meeting minutes"@en .


:SupplierManufacturingPlantID rdf:type owl:Class ;
    rdfs:subClassOf gist:ID ;
    rdfs:label "Supplier Manufacturing Plant"@en ;
    rdfs:comment "The id of the operational unit responsible for production at supplier end."@en .



#################################################################
#    Classes (Manufacturing Plant - End)
#################################################################


#################################################################
#    Object Properties  (Manufacturing Plant - Begin)
#################################################################
### Capacity as a Magnitude
:nameplateCapacity rdf:type owl:ObjectProperty ;
    rdfs:domain :SupplierManufacturingPlant ;
    rdfs:range gist:Magnitude ;
    rdfs:label "Nameplate Capacity"@en ;
    rdfs:comment "The maximum production output (Quantity + Unit) per time period."@en .

###  http://www.apollo-procurement.org/ontology#hasCustomerParty


###  http://www.apollo-procurement.org/ontology#ownsPlant
:ownsPlant rdf:type owl:ObjectProperty ;
           rdfs:domain :Company ;
		   rdfs:range  [ rdf:type owl:Class ;
           owl:unionOf (:OwnManufacturingPlant :SupplierManufacturingPlant) ] ;
           rdfs:label "owns Plant"@en .


:hasNearestPort rdf:type owl:ObjectProperty ;
		   rdfs:domain  [ rdf:type owl:Class ;
           owl:unionOf (:OwnManufacturingPlant :SupplierManufacturingPlant) ] ;        
		   rdfs:ramge :NearestPort ;
		   rdfs:label "has nearest port"@en .



#################################################################
#    Object Properties  (Manufacturing Plant - End)
#################################################################



#################################################################
#    Data Properties - Manufacturing Plant - Begin
#################################################################






#################################################################
#    Data Properties - Manufacturing Plant - End
#################################################################


#################################################################
#    Classes (Approved Supplier Authorization) - Begin
#################################################################
#################################################################
# Approved Supplier Authorization
#################################################################

:ApprovedSupplierAuthorization rdf:type owl:Class ;
    rdfs:subClassOf gist:Agreement ;
    rdfs:label "Approved Supplier Authorization"@en ;
    rdfs:comment "A formal, time-bound authorization indicating that a supplier is approved to supply a specific material to a specific manufacturing plant. Approval defines eligibility, not commercial commitment."@en .




#################################################################
#    Classes (Approved Supplier Authorization) - End
#################################################################


#################################################################
#    Object Properties (Approved Supplier Authorization) - Begin
#################################################################

:approvedSupplier rdf:type owl:ObjectProperty ;
    rdfs:domain :ApprovedSupplierAuthorization ;
    rdfs:range :Company ;
    rdfs:label "approved supplier"@en ;
    rdfs:comment "The supplier organization that has been approved."@en .

:approvedMaterial rdf:type owl:ObjectProperty ;
    rdfs:domain :ApprovedSupplierAuthorization ;
    rdfs:range :MaterialRequiredForProduction ;
    rdfs:label "approved material"@en ;
    rdfs:comment "The material the supplier is approved to supply."@en .

:approvedForPlant rdf:type owl:ObjectProperty ;
    rdfs:domain :ApprovedSupplierAuthorization ;
    rdfs:range :OwnManufacturingPlant ;
    rdfs:label "approved for plant"@en ;
    rdfs:comment "The manufacturing plant for which the approval is valid."@en .




