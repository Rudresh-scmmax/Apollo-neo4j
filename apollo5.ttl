#################################################################
#    Classes - (Material Inventory Snapshot) - Begin
#################################################################

:InventorySnapshot rdf:type owl:Class ;
				  rdfs:subClassOf gist:Event ;
				  rdfs:label "Inventory Snapshot"@en ;
				  rdfs:comment "A point-in-time observation of inventory quantity and type for a specific material at a specific plant. Inventory snapshots represent state, not individual stock movements, and are intended for decision-making and reasoning rather than transactional accounting."@en .

:InventoryType rdf:type owl:Class ;
				  rdfs:subClassOf gist:Category ;
				  rdfs:label "Inventory Type"@en ;
				  rdfs:comment "A categorical classification of inventory based on its status, such as available, obselete, on-hold, quality check pending."@en .

#################################################################
#    Classes - (Material Inventory Snapshot) - End
#################################################################


#################################################################
# Object Properties - (Material Inventory Snapshot) - Begin
#################################################################

:forMaterial rdf:type owl:ObjectProperty ;
				  rdfs:domain :InventorySnapshot ;
				  rdfs:range :MaterialRequiredForProduction ;
				  rdfs:label "for material"@en ;
				  rdfs:comment "Indicates the material for which the inventory snapshot is recorded."@en .

:atPlant rdf:type owl:ObjectProperty ;
				  rdfs:domain :InventorySnapshot ;
				  rdfs:range gist:Organization ;
				  rdfs:label "at plant"@en ;
				  rdfs:comment "Indicates the manufacturing plant or warehouse where the inventory is physically located."@en .

:hasInventoryType rdf:type owl:ObjectProperty ;
				  rdfs:domain :InventorySnapshot ;
				  rdfs:range :InventoryType ;
				  rdfs:label "has inventory type"@en ;
				  rdfs:comment "Specifies the type or status of the inventory (e.g., available, obselete, on-hold)."@en .

###    Magnitude for InventorySnapshot is  defined under :hasMagnitude right at the beginning

#################################################################
# Object properties - (Material Inventory Snapshot) - End
#################################################################

#################################################################
# Data properties - (Material Inventory Snapshot) - Begin
#################################################################


:inventoryDateTime rdf:type owl:DatatypeProperty ;
				  rdfs:domain :InventorySnapshot ;
				  rdfs:range  xsd:dateTime ;
				  rdfs:label "Inventory dateTime" ;
				  rdfs:comment "The date and time at which the Inventory data was pulled from ERP." .



#################################################################
# Data properties - (Material Inventory Snapshot) - End
#################################################################





#################################################################
# Classes - Summary of Procurement History  - Begin
#################################################################


:ProcurementSummary rdf:type owl:Class ;
				  rdfs:subClassOf gist:Information ;
				  rdfs:label "Procurement Summary"@en ;
				  rdfs:comment "An aggregated and interpreted view of historical procurement transactions, derived from ERP data, and used for analysis and decision-making."@en .

#################################################################
# Classes - Summary of Procurement History - End
#################################################################

#################################################################
# Object Properties - Summary of Procurement History - Begin
#################################################################

:hasTransactionPrice rdf:type owl:ObjectProperty ;
				  rdfs:domain :ProcurementSummary ;
				  rdfs:range :TransactionPrice ;
				  rdfs:label "Transaction Price"@en ;
				  rdfs:comment "Indicates the material, plant, supplier, currency, date and price value for which the procurement was done."@en .

:procuredForPlant rdf:type owl:ObjectProperty ;
                    rdfs:domain :ProcurementSummary ;
					rdfs:range :OwnManufacturingPlant ;
                    rdfs:comment "The plant / factory mentioned on the PO or Invoice of the Transaction. "@en ;
                    rdfs:label "The plant this procurementwas for"@en .


:procuredMaterial rdf:type owl:ObjectProperty ;
                    rdfs:domain :ProcurementSummary ;
					rdfs:range :MaterialRequiredForProduction ;
                    rdfs:comment "The raw material mentioned on the PO or Invoice of the Transaction. "@en ;
                    rdfs:label "The MaterialRequiredForProduction this procurementwas for. "@en .


:hasProcuredQuantity rdf:type owl:ObjectProperty ;
    rdfs:domain :ProcurementSummary ;
    rdfs:range gist:Magnitude ;
    rdfs:label "has procured quantity"@en ;
    rdfs:comment "Indicates the total quantity of material procured within the time period covered by this procurement summary."@en .


:underSupplyAgreement rdf:type owl:ObjectProperty ;
                    rdfs:domain :ProcurementSummary ;
					rdfs:range :SupplyAgreement ;
                    rdfs:comment "The applicable supply agreement. "@en ;
                    rdfs:label "The applicable supply agreement. "@en .



#################################################################
# Object properties - Summary of Procurement History - End
#################################################################

#################################################################
# Data properties - Summary of Procurement History - Begin
#################################################################


:transactionDateTime rdf:type owl:DatatypeProperty ;
				  rdfs:domain :ProcurementSummary ;
				  rdfs:range  xsd:dateTime ;
				  rdfs:label "Procurement Summary dateTime" ;
				  rdfs:comment "The date and time at which the Procurement summary data was pulled from ERP." .



