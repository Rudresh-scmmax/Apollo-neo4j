#################################################################
#    Classes (Logistics Route - Begin)
#################################################################

:LogisticsRoute rdf:type owl:Class ;
    rdfs:subClassOf gist:Plan ;
    rdfs:label "Logistics Route"@en ;
    rdfs:comment "A reusable, non-temporal logistics plan defining the intended transport path between origin and destination. This represents how goods may be shipped, not an actual shipment event."@en .


:LogisticsLeg rdf:type owl:Class ;
    rdfs:subClassOf gist:Plan ;
    rdfs:label "Logistics Leg"@en ;
    rdfs:comment "A planned segment of a logistics route between two locations using a single shipment mode."@en .


#################################################################
#    Classes (Logistics Route - End)
#################################################################

#################################################################
#   Object Properties  Logistics Route - Begin
#################################################################


:hasLeg rdf:type owl:ObjectProperty ;
    rdfs:domain :LogisticsRoute ;
    rdfs:range :LogisticsLeg ;
    rdfs:label "has logistics leg"@en .

:legOrigin rdf:type owl:ObjectProperty ;
    rdfs:domain :LogisticsLeg ;
    rdfs:range gist:GeoLocation ;
    rdfs:label "leg origin"@en .

:legDestination rdf:type owl:ObjectProperty ;
    rdfs:domain :LogisticsLeg ;
    rdfs:range gist:GeoLocation ;
    rdfs:label "leg destination"@en .

:usesShipmentMode rdf:type owl:ObjectProperty ;
    rdfs:domain :LogisticsLeg ;
    rdfs:range :ShipmentMode ;
    rdfs:label "uses shipment mode"@en .

:hasDistance rdf:type owl:ObjectProperty ;
    rdfs:domain :LogisticsLeg ;
    rdfs:range gist:Magnitude ;
    rdfs:label "has distance"@en .


:isAssociatedWithOwnManufacturingPlant rdf:type owl:ObjectProperty ;
    rdfs:domain :LogisticsRoute ;
    rdfs:range :OwnManufacturingPlant ;
    rdfs:label "plant the route serves"@en ;
    rdfs:comment "Specifies the OwnManufacturingPlant that the route serves."@en .


:isAssociatedWithSupplierManufacturingPlant rdf:type owl:ObjectProperty ;
    rdfs:domain :LogisticsRoute ;
    rdfs:range :SupplierManufacturingPlant ;
    rdfs:label "supplier plant the route starts at"@en ;
    rdfs:comment "Specifies the SupplierManufacturingPlant that the route starts at."@en .


#################################################################
#   Object Properties  Logistics Route - End
#################################################################



